.home { position: relative; min-height: 100vh; overflow: hidden; }

/* 远山背景（低饱和青绿，多层） */
.bg-mountains {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(120% 60% at 15% 8%, rgba(166, 191, 174, 0.35) 0%, transparent 60%),
    radial-gradient(120% 70% at 85% 12%, rgba(143, 166, 171, 0.3) 0%, transparent 55%),
    linear-gradient(180deg, #efe7d6 0%, #f4ecdd 45%, #f6efe2 100%);
}
.inner { position: relative; z-index: 1; }

/* 云阙开场 */
.hero {
  position: relative;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-deep);
  padding: 40rpx 30rpx 30rpx;
  margin-bottom: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translateY(24rpx);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.hero.entered { opacity: 1; transform: translateY(0); }
.brand-mark { width: 128rpx; height: 148rpx; margin-bottom: 6rpx; }

/* 云阙拱龛肖像（竖幅壁画龛，替代圆形头像，脸部完整可见） */
.yunque-shrine {
  position: relative;
  width: 280rpx;
  height: 372rpx;
  border-radius: 48rpx 48rpx 20rpx 20rpx;
  overflow: hidden;
  border: 3rpx solid var(--dark-gold-soft);
  box-shadow: 0 18rpx 44rpx rgba(120, 86, 40, 0.28), 0 0 0 6rpx rgba(194, 166, 104, 0.12);
  margin-bottom: 26rpx;
  animation: breathe 4s ease-in-out infinite;
}
.shrine-portrait { width: 100%; height: 100%; display: block; }
.shrine-glow {
  position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(180deg, rgba(255, 240, 210, 0.14), transparent 32%, transparent 68%, rgba(120, 80, 30, 0.18));
}
@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.045); }
}
@keyframes halo {
  0%, 100% { opacity: 0.35; transform: scale(1); }
  50% { opacity: 0.9; transform: scale(1.06); }
}
.bubble {
  position: relative;
  background: var(--bg-card-deep);
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 26rpx;
  width: 100%;
}
.bubble-text { font-size: var(--fs-body); color: var(--ink-soft); line-height: 1.7; }
.enter-btn { width: 100%; }
.hint-text { font-size: var(--fs-mini); color: var(--ink-muted); margin-top: 16rpx; }

/* 双模式 */
.mode-grid { display: flex; gap: 20rpx; margin-bottom: 26rpx; }
.mode-card {
  flex: 1;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mode-word {
  font-size: 40rpx;
  color: var(--cinnabar);
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}
.mode-card.outline .mode-word { color: var(--azurite-deep); }
.mode-name { font-size: var(--fs-h2); color: var(--ink); font-weight: 600; }
.mode-desc { font-size: var(--fs-mini); color: var(--ink-muted); margin-top: 8rpx; text-align: center; }

/* 景点卡 */
.spot-card .tag-row { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.spot-summary { margin-top: 18rpx; display: block; }
.enter-arrow { font-size: 48rpx; color: var(--ink-muted); }

/* 商品横滑 */
.section { margin-top: 6rpx; }
.link { font-size: var(--fs-small); }
.goods-scroll { white-space: nowrap; margin-top: 18rpx; }
.goods-item {
  display: inline-flex;
  flex-direction: column;
  width: 220rpx;
  margin-right: 18rpx;
  vertical-align: top;
}
.goods-cover {
  height: 220rpx;
  border-radius: var(--radius);
  background: linear-gradient(160deg, #ece1cd, #e2d5bd);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.goods-cat { font-size: var(--fs-mini); color: var(--dark-gold); }
.goods-cover-img { width: 100%; height: 100%; border-radius: var(--radius); }
.goods-name {
  font-size: var(--fs-small);
  color: var(--ink);
  white-space: normal;
  line-height: 1.4;
  height: 66rpx;
  overflow: hidden;
}
.goods-price { font-size: var(--fs-mini); color: var(--cinnabar); margin-top: 6rpx; }

/* ===== 氛围：薄雾 / 飘金鳞 / 描金旋转环 ===== */
.bg-mist {
  position: absolute; left: -30%; right: -30%; top: 8%; height: 42%;
  background: radial-gradient(60% 100% at 30% 50%, rgba(255,250,240,0.5), transparent 70%);
  animation: mistDrift 26s ease-in-out infinite; pointer-events: none;
}
@keyframes mistDrift {
  0%,100% { transform: translateX(-12%); } 50% { transform: translateX(12%); }
}
.bg-scales { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.bg-scale {
  position: absolute; top: -40rpx; left: calc(10% + var(--i) * 14.5%);
  width: 18rpx; height: 24rpx;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  background: linear-gradient(180deg, #f3d488, #c79a44);
  box-shadow: 0 0 10rpx rgba(220,180,100,0.6); opacity: 0;
  animation: scaleFall calc(10s + var(--i) * 1.3s) linear infinite;
  animation-delay: calc(var(--i) * 1.7s);
}
@keyframes scaleFall {
  0% { transform: translateY(-40rpx) rotate(0); opacity: 0; }
  12% { opacity: 0.7; } 85% { opacity: 0.5; }
  100% { transform: translateY(110vh) rotate(280deg); opacity: 0; }
}
.yunque-ring {
  position: absolute; inset: -14rpx; border-radius: 50%;
  border: 2rpx dashed rgba(184,150,86,0.55);
  animation: ringSpin 18s linear infinite;
}
@keyframes ringSpin { to { transform: rotate(360deg); } }

/* 分级入场（hero entered 后，后续兄弟依次淡入） */
.rise { opacity: 0; transform: translateY(26rpx); transition: opacity .7s ease, transform .7s ease; }
.hero.entered ~ .rise { opacity: 1; transform: translateY(0); }
.rise-1 { transition-delay: .25s; }
.rise-2 { transition-delay: .45s; }
.rise-3 { transition-delay: .65s; }
