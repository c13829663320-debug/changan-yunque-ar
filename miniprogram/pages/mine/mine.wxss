.mine {
  min-height: 100vh;
  background: var(--bg);
}

/* —— 头部 —— */
.mine-head {
  position: relative;
  padding: 72rpx 0 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background:
    radial-gradient(120% 100% at 50% 0%, var(--moon), transparent 70%),
    linear-gradient(180deg, var(--ivory-deep), var(--bg));
  overflow: hidden;
}
.mine-head::before {
  content: '';
  position: absolute;
  top: 36rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  border: 1rpx solid var(--dark-gold-soft);
  opacity: 0.4;
}
.avatar {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid var(--dark-gold-soft);
  box-shadow: var(--shadow-deep);
  margin-bottom: 20rpx;
}
.avatar-img { width: 100%; height: 100%; }
.mine-name {
  font-size: var(--fs-title);
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 4rpx;
}
.mine-sub {
  font-size: var(--fs-small);
  color: var(--ink-muted);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.mine-body { padding-top: 6rpx; }

/* —— 克制的入场动效（仅一次，不循环） —— */
@keyframes rise {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.rise { animation: rise 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both; }

/* —— 统计三格：鎏金数字 + 克制渐变暗纹 —— */
.stat-grid { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.stat {
  flex: 1;
  background:
    radial-gradient(100% 80% at 50% -20%, rgba(194, 166, 104, 0.16), transparent 68%),
    linear-gradient(168deg, var(--bg-card) 0%, var(--bg-card-deep) 100%);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: 26rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat:active { transform: scale(0.97); }
.stat-icon { margin-bottom: 12rpx; opacity: 0.92; }
.stat-num {
  font-size: 46rpx;
  line-height: 1.1;
  color: var(--dark-gold);
  font-weight: 600;
  text-shadow: 0 1rpx 0 rgba(255, 249, 230, 0.9), 0 3rpx 8rpx rgba(168, 137, 58, 0.28);
}
.stat-label {
  font-size: var(--fs-small);
  color: var(--ink-muted);
  margin-top: 8rpx;
  letter-spacing: 3rpx;
}

/* —— 卡片统一头 —— */
.card-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-head-titles { display: flex; flex-direction: column; }
.card-sub {
  font-size: var(--fs-mini);
  color: var(--ink-muted);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* 卡片头右侧总进度：鎏金数字 + 细分隔 */
.head-progress { display: flex; align-items: baseline; }
.hp-got {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--dark-gold);
  text-shadow: 0 1rpx 0 rgba(255, 249, 230, 0.9), 0 2rpx 6rpx rgba(168, 137, 58, 0.25);
}
.hp-sep {
  font-size: 26rpx;
  color: var(--line);
  margin: 0 8rpx;
  font-weight: 400;
}
.hp-all { font-size: 26rpx; color: var(--ink-muted); }

/* —— 龙鳞集章墙 —— */
.scale-card { padding: 30rpx 24rpx; }
.scale-wall { display: flex; flex-wrap: wrap; }
.scale-cell {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  padding: 6rpx 0 16rpx;
}

/* 按景点分组 */
.wall-group {
  padding-bottom: 22rpx;
  margin-bottom: 10rpx;
  border-bottom: 1rpx dashed var(--line);
}
.wall-group:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
.wall-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0 10rpx;
}
.wall-group-head:first-child { margin-top: 4rpx; }
.wall-group-name {
  font-size: var(--fs-body);
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 2rpx;
  padding-left: 18rpx;
  position: relative;
}
.wall-group-name::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--dark-gold-soft), var(--dark-gold));
  box-shadow: 0 1rpx 2rpx rgba(168, 137, 58, 0.35);
}
/* 组计数小丸：鎏金已得数 / 总数 */
.wall-group-count {
  display: inline-flex;
  align-items: baseline;
  background: var(--bg-card-deep);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 5rpx 16rpx;
}
.wgc-got { font-size: var(--fs-small); color: var(--dark-gold); font-weight: 600; }
.wgc-sep { font-size: var(--fs-mini); color: var(--line); margin: 0 4rpx; }
.wgc-total { font-size: var(--fs-mini); color: var(--ink-muted); }

/* —— 景点巡游卡片 —— */
.spot-card { padding: 30rpx 24rpx; }
.spot-list { display: flex; flex-direction: column; }
.spot-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: var(--bg-card-deep);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  transition: transform 0.15s ease, box-shadow 0.25s ease;
}
.spot-row:last-child { margin-bottom: 0; }
.spot-row:active { transform: scale(0.99); }
.spot-row.soon { opacity: 0.72; }
.spot-emblem {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--ivory-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}
.spot-emblem.on { box-shadow: var(--shadow); }
.spot-emblem-img { width: 100%; height: 100%; }
.spot-emblem-text { font-size: var(--fs-small); color: var(--ink-muted); }
.spot-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.spot-name { font-size: var(--fs-body); color: var(--ink); font-weight: 600; }
.spot-sub { font-size: var(--fs-mini); color: var(--ink-muted); margin-top: 6rpx; }
.spot-meta { margin-top: 10rpx; display: flex; }
.spot-tag {
  font-size: var(--fs-mini);
  color: var(--ink-muted);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
}
.spot-tag.visited {
  color: var(--dark-gold);
  border-color: var(--dark-gold-soft);
  background: var(--ivory);
}
.spot-badge {
  font-size: var(--fs-mini);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
}
.spot-badge.on { color: var(--dark-gold); border: 1rpx solid var(--dark-gold-soft); }
.spot-badge.soon { color: var(--ink-muted); background: var(--bg-card); }

/* —— 我的入口 —— */
.menu-card { padding: 30rpx 24rpx; }
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 18rpx 6rpx;
  border-bottom: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  transition: background 0.15s ease;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--bg-card-deep); }
.m-left { display: flex; align-items: center; gap: 22rpx; }
.m-icon { flex-shrink: 0; opacity: 0.9; }
.m-label { font-size: var(--fs-body); color: var(--ink-soft); letter-spacing: 1rpx; }
.m-arrow { flex-shrink: 0; opacity: 0.65; }

/* 意向单重点入口：朱砂渐变底 + 象牙白瓦片内嵌图标 */
.menu-item.hot {
  padding: 22rpx;
  margin-bottom: 14rpx;
  min-height: 0;
  background: linear-gradient(135deg, var(--cinnabar-soft) 0%, var(--ochre-deep) 100%);
  border: none;
  border-radius: var(--radius);
}
.menu-item.hot:active { opacity: 0.94; }
.hot-left { display: flex; align-items: center; gap: 18rpx; }
.hot-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(160deg, #fdf8ee 0%, #efe4cc 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.75), 0 2rpx 8rpx rgba(90, 40, 20, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hot-info { display: flex; flex-direction: column; }
.hot-label { color: var(--bg-card); font-weight: 600; }
.hot-sub {
  font-size: var(--fs-mini);
  color: var(--ivory-deep);
  margin-top: 4rpx;
}

.reset-btn { margin-top: 12rpx; }

/* 底部品牌落款 */
.brand-foot { display: flex; justify-content: center; padding: 26rpx 0 8rpx; }
.brand-foot-img { width: 188rpx; height: 258rpx; opacity: 0.94; }

/* —— 文物图鉴入口卡片 —— */
.album-card { cursor: pointer; }
.album-mini {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
}
.album-mini-cell {
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(160deg, var(--bg-card-deep) 0%, #e8dcc4 100%);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 已收录：鎏金描边 + 真实缩略图 */
.album-mini-cell.on {
  border: 2rpx solid var(--dark-gold);
  box-shadow: 0 6rpx 16rpx rgba(150, 110, 50, 0.22), inset 0 0 0 1rpx rgba(194, 166, 104, 0.45);
}
.album-relic-img { width: 100%; height: 100%; }
.album-cell-body {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
