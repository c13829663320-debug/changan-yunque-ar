.mine {
  min-height: 100vh;
  background: var(--bg);
}

/* —— 头部 —— */
.mine-head {
  position: relative;
  padding: 72rpx 0 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background:
    radial-gradient(120% 100% at 50% 0%, var(--moon), transparent 70%),
    linear-gradient(180deg, var(--ivory-deep), var(--bg));
  overflow: hidden;
}
.mine-head::before {
  content: '';
  position: absolute;
  top: 36rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  border: 1rpx solid var(--dark-gold-soft);
  opacity: 0.4;
}
.avatar {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid var(--dark-gold-soft);
  box-shadow: var(--shadow-deep);
  margin-bottom: 20rpx;
}
.avatar-img { width: 100%; height: 100%; }
.mine-name {
  font-size: var(--fs-title);
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 4rpx;
}
.mine-sub {
  font-size: var(--fs-small);
  color: var(--ink-muted);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.mine-body { padding-top: 6rpx; }

/* —— 克制的入场动效（仅一次，不循环） —— */
@keyframes rise {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.rise { animation: rise 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both; }

/* —— 统计 —— */
.stat-grid { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.stat {
  flex: 1;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num { font-size: 44rpx; color: var(--dark-gold); font-weight: 600; }
.stat-label { font-size: var(--fs-small); color: var(--ink-muted); margin-top: 6rpx; }
.stat:active { transform: scale(0.98); }
.stat { transition: transform 0.15s ease; }

/* —— 卡片统一头 —— */
.card-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-head-titles { display: flex; flex-direction: column; }
.card-sub {
  font-size: var(--fs-mini);
  color: var(--ink-muted);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* —— 龙鳞集章墙 —— */
.scale-card { padding: 30rpx 24rpx; }
.scale-progress {
  font-size: var(--fs-h2);
  color: var(--dark-gold);
  font-weight: 600;
}
.scale-wall { display: flex; flex-wrap: wrap; }
.scale-cell {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 16rpx;
}
.scale-medal {
  width: 92rpx;
  height: 96rpx;
  /* 鳞/水滴形 */
  border-radius: 50% 50% 50% 50% / 64% 64% 36% 36%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card-deep);
  border: 1rpx solid var(--line);
  transition: transform 0.2s ease;
}
.scale-medal.got {
  background: linear-gradient(155deg, var(--dark-gold-soft) 0%, var(--dark-gold) 80%);
  border: 1rpx solid var(--dark-gold);
  box-shadow: var(--shadow-deep);
}
.scale-core {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--line);
}
.scale-medal.got .scale-core {
  background: var(--bg-card);
}
.scale-name {
  font-size: var(--fs-small);
  color: var(--ink-muted);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}
.scale-name.on { color: var(--ink); font-weight: 600; }
.scale-hall {
  font-size: var(--fs-mini);
  color: var(--ink-muted);
  margin-top: 4rpx;
}

/* —— 景点巡游卡片 —— */
.spot-card { padding: 30rpx 24rpx; }
.spot-list { display: flex; flex-direction: column; }
.spot-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: var(--bg-card-deep);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  transition: transform 0.15s ease, box-shadow 0.25s ease;
}
.spot-row:last-child { margin-bottom: 0; }
.spot-row:active { transform: scale(0.99); }
.spot-row.soon { opacity: 0.72; }
.spot-emblem {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--ivory-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}
.spot-emblem.on { box-shadow: var(--shadow); }
.spot-emblem-img { width: 100%; height: 100%; }
.spot-emblem-text { font-size: var(--fs-small); color: var(--ink-muted); }
.spot-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.spot-name { font-size: var(--fs-body); color: var(--ink); font-weight: 600; }
.spot-sub { font-size: var(--fs-mini); color: var(--ink-muted); margin-top: 6rpx; }
.spot-meta { margin-top: 10rpx; display: flex; }
.spot-tag {
  font-size: var(--fs-mini);
  color: var(--ink-muted);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
}
.spot-tag.visited {
  color: var(--dark-gold);
  border-color: var(--dark-gold-soft);
  background: var(--ivory);
}
.spot-badge {
  font-size: var(--fs-mini);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
}
.spot-badge.on { color: var(--dark-gold); border: 1rpx solid var(--dark-gold-soft); }
.spot-badge.soon { color: var(--ink-muted); background: var(--bg-card); }

/* —— 我的入口 —— */
.menu-card { padding: 30rpx 24rpx; }
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.menu-item:last-child { border-bottom: none; }
/* 意向单重点入口 */
.menu-item.hot {
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(135deg, var(--cinnabar-soft) 0%, var(--ochre-deep) 100%);
  border: none;
  border-radius: var(--radius);
}
.hot-left { display: flex; align-items: center; gap: 18rpx; }
.hot-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  color: var(--cinnabar);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}
.hot-info { display: flex; flex-direction: column; }
.hot-label { color: var(--bg-card); font-weight: 600; }
.hot-sub {
  font-size: var(--fs-mini);
  color: var(--ivory-deep);
  margin-top: 4rpx;
}
.m-label { font-size: var(--fs-body); color: var(--ink-soft); }
.m-arrow { font-size: 36rpx; color: var(--ink-muted); }
.menu-item.hot .m-arrow { color: var(--bg-card); }

.reset-btn { margin-top: 12rpx; }

/* 底部品牌落款 */
.brand-foot { display: flex; justify-content: center; padding: 26rpx 0 8rpx; }
.brand-foot-img { width: 188rpx; height: 258rpx; opacity: 0.94; }

/* —— 文物图鉴入口卡片 —— */
.album-card { cursor: pointer; }
.album-mini {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}
.album-mini-cell {
  width: 76rpx;
  height: 76rpx;
  border-radius: 14rpx;
  background: rgba(154, 120, 60, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.album-mini-cell.on {
  background: linear-gradient(135deg, rgba(199, 154, 75, 0.35), rgba(158, 59, 46, 0.25));
  box-shadow: inset 0 0 0 1rpx rgba(158, 59, 46, 0.4);
}
.album-mini-mark { font-size: 26rpx; color: var(--ink-muted); }
.album-mini-cell.on .album-mini-mark { color: #9e3b2e; font-weight: 600; }

/* —— 龙鳞墙：按景点分组 —— */
.wall-group { padding-bottom: 20rpx; margin-bottom: 8rpx; border-bottom: 1rpx dashed var(--line); }
.wall-group:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
.wall-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 6rpx;
}
.wall-group-head:first-child { margin-top: 0; }
.wall-group-name {
  font-size: var(--fs-body);
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 1rpx;
  padding-left: 16rpx;
  position: relative;
}
.wall-group-name::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--dark-gold-soft), var(--dark-gold));
}
.wall-group-count { font-size: var(--fs-mini); color: var(--ink-muted); }
/* 已得鳞提质：柔光高光，仍纯 CSS 无图片 */
.scale-medal.got {
  background: linear-gradient(155deg, var(--dark-gold-soft) 0%, var(--dark-gold) 80%);
  border: 1rpx solid var(--dark-gold);
  box-shadow: var(--shadow-deep), inset 0 2rpx 6rpx rgba(255, 248, 224, 0.55);
}
.scale-medal.got .scale-core {
  background: radial-gradient(circle at 35% 30%, #fff6dd 0%, var(--bg-card) 70%);
}
