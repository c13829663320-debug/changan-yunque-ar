<view class="mine">
  <!-- 头部 -->
  <view class="mine-head">
    <view class="avatar"><image class="avatar-img" src="/assets/characters/yunque-avatar.jpg" mode="aspectFill"></image></view>
    <text class="mine-name">云阙旅人</text>
    <text class="mine-sub">已集 {{scaleCount}} 鳞 · 收录 {{relicCount}} 件文物 · 走过 {{stampCount}} 处</text>
  </view>

  <view class="page-wrap mine-body">
    <!-- 统计（三格均可点击） -->
    <view class="stat-grid rise" style="animation-delay:.02s">
      <view class="stat" data-type="scales" bindtap="goDetail">
        <line-icon class="stat-icon" name="scale" size="{{38}}"></line-icon>
        <text class="stat-num">{{scaleCount}}</text>
        <text class="stat-label">龙鳞</text>
      </view>
      <view class="stat" data-type="stamps" bindtap="goDetail">
        <line-icon class="stat-icon" name="stamp" size="{{38}}"></line-icon>
        <text class="stat-num">{{stampCount}}</text>
        <text class="stat-label">集章</text>
      </view>
      <view class="stat" bindtap="goAlbum">
        <line-icon class="stat-icon" name="relic" size="{{38}}"></line-icon>
        <text class="stat-num">{{relicCount}}</text>
        <text class="stat-label">文物</text>
      </view>
    </view>

    <!-- 龙鳞集章墙（按景点分组） -->
    <view class="card scale-card rise" style="animation-delay:.08s">
      <view class="card-head">
        <view class="card-head-titles">
          <text class="title-h2">龙鳞集章</text>
          <text class="card-sub">{{wallSummary}}</text>
        </view>
        <view class="head-progress">
          <text class="hp-got">{{scaleCount}}</text>
          <text class="hp-sep">/</text>
          <text class="hp-all">{{scaleTotal}}</text>
        </view>
      </view>
      <block wx:for="{{scaleGroups}}" wx:key="spotId" wx:for-item="g">
        <view class="wall-group">
          <view class="wall-group-head">
            <text class="wall-group-name">{{g.spotName}}</text>
            <text class="wall-group-count"><text class="wgc-got">{{g.got}}</text><text class="wgc-sep">/</text><text class="wgc-total">{{g.total}}</text></text>
          </view>
          <view class="scale-wall">
            <view class="scale-cell" wx:for="{{g.cells}}" wx:for-item="c" wx:key="name">
              <dragon-scale got="{{c.got}}" size="lg" enamel="{{c.enamel}}" showLabel name="{{c.name}}" hall="{{c.hall}}"></dragon-scale>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 文物图鉴入口 -->
    <view class="card album-card rise" style="animation-delay:.11s" bindtap="goAlbum">
      <view class="card-head">
        <view class="card-head-titles">
          <text class="title-h2">文物图鉴</text>
          <text class="card-sub">现场扫描 · 收录长安遗珍</text>
        </view>
        <view class="head-progress">
          <text class="hp-got">{{relicCount}}</text>
          <text class="hp-sep">/</text>
          <text class="hp-all">{{relicTotal}}</text>
        </view>
      </view>
      <view class="album-mini">
        <view class="album-mini-cell {{item.collected ? 'on' : 'off'}}" wx:for="{{relicCells}}" wx:key="id">
          <image
            wx:if="{{item.collected && !relicImgError[item.id]}}"
            class="album-relic-img"
            src="{{item.image}}"
            mode="aspectFill"
            data-id="{{item.id}}"
            binderror="onRelicImgError"
          ></image>
          <view wx:else class="album-cell-body">
            <line-icon name="{{item.collected ? 'relic' : 'lock'}}" size="{{32}}"></line-icon>
          </view>
        </view>
      </view>
    </view>

    <!-- 景点巡游 -->
    <view class="card spot-card rise" style="animation-delay:.14s">
      <view class="card-head">
        <view class="card-head-titles">
          <text class="title-h2">景点巡游</text>
          <text class="card-sub">已到访 {{stampCount}} 处宫殿</text>
        </view>
      </view>
      <view class="spot-list">
        <view
          class="spot-row {{item.enabled ? '' : 'soon'}}"
          wx:for="{{spotCards}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goSpot"
        >
          <view class="spot-emblem {{item.enabled ? 'on' : ''}}">
            <image wx:if="{{item.cover}}" class="spot-emblem-img" src="{{item.cover}}" mode="aspectFill"></image>
            <text wx:else class="spot-emblem-text">{{item.city}}</text>
          </view>
          <view class="spot-info">
            <text class="spot-name">{{item.name}}</text>
            <text class="spot-sub">{{item.subtitle}}</text>
            <view class="spot-meta">
              <text class="spot-tag {{item.visitedCount > 0 ? 'visited' : ''}}">{{item.visitedText}}</text>
            </view>
          </view>
          <text class="spot-badge {{item.enabled ? 'on' : 'soon'}}">{{item.enabled ? '可巡游' : '即将上线'}}</text>
        </view>
      </view>
    </view>

    <!-- 我的入口 -->
    <view class="card menu-card rise" style="animation-delay:.2s">
      <view class="card-head">
        <view class="card-head-titles">
          <text class="title-h2">我的</text>
          <text class="card-sub">意向 · 预约 · 收藏</text>
        </view>
      </view>

      <!-- 意向单：重点入口（保持现有跳转） -->
      <view class="menu-item hot" data-k="intention" bindtap="onMenu">
        <view class="hot-left">
          <view class="hot-icon"><line-icon name="intention" size="{{36}}"></line-icon></view>
          <view class="hot-info">
            <text class="m-label hot-label">我的意向单</text>
            <text class="hot-sub">预售与意向登记 · 优先通知</text>
          </view>
        </view>
        <line-icon class="m-arrow" name="arrow" size="{{28}}" theme="light"></line-icon>
      </view>

      <view class="menu-item" data-k="booking" bindtap="onMenu">
        <view class="m-left"><line-icon class="m-icon" name="booking" size="{{38}}"></line-icon><text class="m-label">体验预约</text></view>
        <line-icon class="m-arrow" name="arrow" size="{{28}}"></line-icon>
      </view>
      <view class="menu-item" data-k="source" bindtap="onMenu">
        <view class="m-left"><line-icon class="m-icon" name="source" size="{{38}}"></line-icon><text class="m-label">史料卡收藏</text></view>
        <line-icon class="m-arrow" name="arrow" size="{{28}}"></line-icon>
      </view>
      <view class="menu-item" data-k="share" bindtap="onMenu">
        <view class="m-left"><line-icon class="m-icon" name="wish" size="{{38}}"></line-icon><text class="m-label">我的祈愿分享</text></view>
        <line-icon class="m-arrow" name="arrow" size="{{28}}"></line-icon>
      </view>
      <view class="menu-item" data-k="about" bindtap="onMenu">
        <view class="m-left"><line-icon class="m-icon" name="about" size="{{38}}"></line-icon><text class="m-label">关于长安云阙</text></view>
        <line-icon class="m-arrow" name="arrow" size="{{28}}"></line-icon>
      </view>
    </view>

    <button class="btn-ghost reset-btn rise" style="animation-delay:.26s" bindtap="onReset">重置巡游进度</button>

    <view class="brand-foot rise" style="animation-delay:.3s">
      <image class="brand-foot-img" src="/assets/brand/brand-full.png" mode="aspectFit"></image>
    </view>
  </view>
</view>
