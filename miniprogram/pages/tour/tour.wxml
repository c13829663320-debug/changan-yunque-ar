<view class="page-wrap tour">
  <!-- 进度与模式 -->
  <view class="card progress-head">
    <view class="row-between head-row">
      <view class="head-title">
        <text class="title-h2">云阙AR巡游</text>
        <text class="head-sub">{{headSub}}</text>
      </view>
      <view class="seg-group">
        <view class="seg {{mode==='cloud'?'on':''}}" data-mode="cloud" bindtap="switchMode" hover-class="seg-hover" hover-stay-time="80">云游</view>
        <view class="seg {{mode==='onsite'?'on':''}}" data-mode="onsite" bindtap="switchMode" hover-class="seg-hover" hover-stay-time="80">现场</view>
      </view>
    </view>

    <!-- 卷首景点切换：仅列已上线景点；多景点时出现，单景点时自隐 -->
    <view class="spot-switch" wx:if="{{spots.length > 1}}">
      <view class="spot-switch-inner">
        <view
          class="spot-tab {{spotId===item.id?'on':''}}"
          wx:for="{{spots}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="switchSpot"
          hover-class="spot-tab-hover"
          hover-stay-time="80"
        >{{item.shortName}}</view>
      </view>
      <view class="spot-switch-line"></view>
    </view>

    <!-- 龙鳞集录 -->
    <view class="scale-line">
      <view class="row-between scale-head">
        <text class="scale-text">龙鳞集录</text>
        <text class="scale-num">{{scaleCount}}<text class="scale-num-sep"> / </text>{{total}}</text>
      </view>
      <view class="scale-row">
        <dragon-scale
          wx:for="{{scaleCells}}"
          wx:for-item="cell"
          wx:key="n"
          size="sm"
          got="{{cell.got}}"
          enamel="{{cell.enamel}}"
        ></dragon-scale>
      </view>
      <text class="scale-hint">{{modeHint}}</text>
    </view>

    <button class="btn-primary continue-btn" bindtap="onContinue">{{continueText}}</button>
  </view>

  <!-- 路线卷轴 -->
  <view class="scroll-wrap">
    <view class="scroll-rod"><view class="rod-cap left"></view><view class="rod-cap right"></view></view>
    <view class="route" wx:if="{{scenes.length > 0}}">
      <view
        class="route-item {{item.state}} {{item.isCurrent?'is-current':''}}"
        wx:for="{{scenes}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-state="{{item.state}}"
        bindtap="onTapScene"
        hover-class="route-hover"
        hover-stay-time="80"
      >
        <view class="node">
          <text class="node-index">{{item.index}}</text>
        </view>
        <view class="route-card">
          <view class="row-between">
            <text class="route-name">{{item.name}}</text>
            <text class="route-state">{{item.stateLabel}}</text>
          </view>
          <text class="route-role">你将成为：{{item.role}}</text>
          <view class="route-foot">
            <view class="route-scale">
              <line-icon name="scale" size="{{26}}"></line-icon>
              <text class="route-scale-name">{{item.scaleName}}</text>
            </view>
            <view class="route-action">
              <view class="route-cta" wx:if="{{item.state==='unlocked'}}">
                <text class="route-cta-text">前往</text>
                <line-icon name="arrow" size="{{26}}" theme="gold"></line-icon>
              </view>
              <line-icon class="route-lock" size="{{30}}" wx:if="{{item.state==='locked'}}"></line-icon>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态：长卷未铺展 -->
    <view class="empty" wx:if="{{scenes.length === 0}}">
      <view class="empty-seal"></view>
      <text class="empty-title">长卷待展</text>
      <text class="empty-desc">{{spotName}}的{{total}}阙画卷正在缓缓铺陈，敬请期待。</text>
    </view>

    <view class="scroll-rod bottom"><view class="rod-cap left"></view><view class="rod-cap right"></view></view>
  </view>
</view>
