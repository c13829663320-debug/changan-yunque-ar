/* ============================================================
   云阙巡游 · tour 页打磨
   盛唐敦煌长卷美学：低饱和、沉静华贵；暗金仅用于龙鳞，朱砂克制
   全部颜色/字号/圆角/间距/阴影均引用 tokens.wxss
   ============================================================ */

.tour { padding-top: 20rpx; }

/* ============================================================
   卷首卡：标题 + 分段控件 + 景点切换 + 龙鳞 + 主按钮
   三者质感统一：朱砂鎏金渐变 / 暗槽托 / 绢丝高光
   ============================================================ */
.progress-head { padding-bottom: 30rpx; }
.head-row { align-items: flex-start; }
.head-title { display: flex; flex-direction: column; }
.head-sub {
  font-size: var(--fs-mini);
  color: var(--ink-muted);
  letter-spacing: 3rpx;
  margin-top: 6rpx;
}

/* 云游 / 现场 分段控件 */
.seg-group {
  display: flex;
  background: var(--bg-card-deep);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  padding: 5rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(90, 74, 50, 0.08);
}
.seg {
  padding: 10rpx 28rpx;
  font-size: var(--fs-small);
  letter-spacing: 2rpx;
  color: var(--ink-muted);
  border-radius: var(--radius-pill);
  transition: color 0.25s ease, background 0.3s ease, box-shadow 0.25s ease;
}
.seg.on {
  background: var(--grad-cinnabar);
  color: #fbf3e4;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(158, 74, 42, 0.26), inset 0 2rpx 3rpx rgba(255, 244, 224, 0.28);
}
.seg-hover { opacity: 0.85; }

/* ---------- 卷首景点切换（多景点时出现） ---------- */
.spot-switch { position: relative; margin: 22rpx 0 4rpx; }
.spot-switch-inner {
  display: flex;
  background: var(--bg-card-deep);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  padding: 5rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(90, 74, 50, 0.08);
}
.spot-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--fs-body);
  letter-spacing: 3rpx;
  color: var(--ink-muted);
  border-radius: var(--radius-pill);
  transition: color 0.25s ease, background 0.3s ease, box-shadow 0.25s ease;
}
.spot-tab.on {
  background: var(--grad-cinnabar);
  color: #fbf3e4;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(158, 74, 42, 0.26), inset 0 2rpx 3rpx rgba(255, 244, 224, 0.28);
}
.spot-tab-hover { opacity: 0.85; }
/* 卷首下沿一缕鎏金绢丝，呼应长卷轴头 */
.spot-switch-line {
  position: absolute;
  left: 8%;
  right: 8%;
  bottom: -12rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--dark-gold-soft) 28%, var(--dark-gold) 50%, var(--dark-gold-soft) 72%, transparent);
  opacity: 0.7;
}

/* ---------- 龙鳞集录 ---------- */
.scale-line { margin: 26rpx 0 26rpx; }
.scale-head { align-items: baseline; margin-bottom: 16rpx; }
.scale-text { font-size: var(--fs-small); color: var(--ink-soft); letter-spacing: 2rpx; }
.scale-num { font-size: var(--fs-h2); font-weight: 600; color: var(--dark-gold); }
.scale-num-sep { font-size: var(--fs-small); color: var(--ink-muted); font-weight: 400; }

/* 鎏金暗槽托：内凹收分，衬托龙鳞 */
.scale-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(180deg, var(--bg-card-deep) 0%, #ecdfc6 100%);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  padding: 20rpx 30rpx;
  margin-top: 4rpx;
  box-shadow: inset 0 3rpx 8rpx rgba(90, 74, 50, 0.12), inset 0 -2rpx 4rpx rgba(255, 252, 244, 0.6);
}
.scale-hint {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-mini);
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

/* 主按钮：与分段/景点切换同源朱砂鎏金，绢丝高光 */
.continue-btn {
  margin-top: 6rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(158, 74, 42, 0.30), inset 0 2rpx 3rpx rgba(255, 244, 224, 0.30);
}
.continue-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -30%;
  width: 36%;
  height: 100%;
  background: linear-gradient(105deg, transparent, rgba(255, 246, 224, 0.32), transparent);
  transform: skewX(-18deg);
}

/* ============================================================
   卷轴路线
   ============================================================ */
.scroll-wrap { position: relative; padding: 6rpx 2rpx 0; }

/* 卷轴轴头（上下两端绫杆） */
.scroll-rod {
  position: relative;
  height: 18rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, var(--ochre-deep) 0%, var(--dark-gold-soft) 50%, var(--ochre-deep) 100%);
  box-shadow: 0 4rpx 12rpx rgba(120, 90, 40, 0.22), inset 0 2rpx 3rpx rgba(255, 248, 224, 0.5);
}
.scroll-rod.bottom { margin-top: 26rpx; }
.rod-cap {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, var(--dark-gold-soft), var(--dark-gold));
  box-shadow: 0 2rpx 6rpx rgba(120, 90, 40, 0.35), inset 0 1rpx 2rpx rgba(255, 248, 224, 0.5);
}
.rod-cap.left { left: -8rpx; }
.rod-cap.right { right: -8rpx; }

/* 绢丝中轴：贯穿各节点的路线 */
.route { position: relative; padding: 14rpx 4rpx 4rpx 10rpx; }
.route-item {
  position: relative;
  display: flex;
  padding-bottom: 26rpx;
  /* 长卷徐徐展开：逐点淡入上移 */
  animation: riseIn 0.5s ease both;
}
.route-item:nth-child(1) { animation-delay: 0.04s; }
.route-item:nth-child(2) { animation-delay: 0.12s; }
.route-item:nth-child(3) { animation-delay: 0.20s; }
.route-item:nth-child(4) { animation-delay: 0.28s; }
.route-item:nth-child(5) { animation-delay: 0.36s; }
.route-item:nth-child(6) { animation-delay: 0.44s; }
.route-item:nth-child(7) { animation-delay: 0.52s; }

@keyframes riseIn {
  from { opacity: 0; transform: translateY(26rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 连接线（绢丝） */
.route-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 31rpx;
  top: 66rpx;
  width: 2rpx;
  height: calc(100% - 40rpx);
  background: linear-gradient(180deg, var(--line) 0%, var(--ochre) 55%, var(--line) 100%);
}

/* 节点圆（默认 = 锁定灰玉） */
.node {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, var(--bg-card-deep), #e7ddc9);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
  z-index: 1;
  transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}
.node-index { font-size: var(--fs-small); font-weight: 600; color: var(--ink-muted); }

/* 路线卡片 */
.route-card {
  flex: 1;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 22rpx 24rpx;
  transition: box-shadow 0.25s ease, transform 0.2s ease, border-color 0.3s ease, opacity 0.3s ease;
}
.route-name { font-size: var(--fs-h2); font-weight: 600; color: var(--ink); letter-spacing: 1rpx; }
.route-state { font-size: var(--fs-mini); color: var(--ink-muted); letter-spacing: 1rpx; }
.route-role {
  display: block;
  font-size: var(--fs-mini);
  color: var(--ink-soft);
  margin-top: 10rpx;
  line-height: 1.5;
}
.route-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.route-scale { display: flex; align-items: center; }
.route-scale-name { font-size: var(--fs-mini); color: var(--ochre-deep); letter-spacing: 1rpx; margin-left: 8rpx; }
.route-action { display: flex; align-items: center; }
.route-cta { display: flex; align-items: center; }
.route-cta-text { font-size: var(--fs-mini); color: var(--cinnabar); letter-spacing: 2rpx; margin-right: 4rpx; }

/* 可点反馈 */
.route-hover .route-card { transform: scale(0.985); box-shadow: var(--shadow-deep); }

/* ---------- 三态 ---------- */
/* 已完成：鎏金环 + 金芯（节点右下角鎏金小芯） */
.route-item.completed .node {
  background: var(--bg-card);
  border: 3rpx solid var(--dark-gold);
  box-shadow: inset 0 0 0 2rpx rgba(168, 137, 58, 0.12);
}
.route-item.completed .node-index { color: var(--dark-gold); }
.route-item.completed .node::after {
  content: '';
  position: absolute;
  right: -3rpx;
  bottom: -3rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--grad-gold);
  border: 2rpx solid var(--bg-card);
}
.route-item.completed .route-state { color: var(--dark-gold); }
.route-item.completed .route-scale-name { color: var(--dark-gold); }
.route-item.completed .route-card {
  border-color: rgba(168, 137, 58, 0.45);
  background: linear-gradient(180deg, var(--bg-card) 0%, #f7efdd 100%);
}

/* 当前可进入（unlocked）：朱砂收边 + 高光 + 呼吸光圈，明确"现在就去" */
.route-item.unlocked .node {
  background: var(--bg-card);
  border-color: var(--cinnabar);
  animation: breath 2.6s ease-in-out infinite;
}
.route-item.unlocked .node-index { color: var(--cinnabar); font-weight: 700; }
.route-item.unlocked .route-state { color: var(--cinnabar); }
.route-item.unlocked .route-card {
  border-color: var(--cinnabar-soft);
  box-shadow: var(--shadow-deep), inset 0 2rpx 4rpx rgba(255, 252, 244, 0.7);
  background: linear-gradient(180deg, var(--bg-card) 0%, #fbf1e6 100%);
}

@keyframes breath {
  0%, 100% { box-shadow: 0 0 0 2rpx rgba(158, 74, 42, 0.16); }
  50% { box-shadow: 0 0 0 12rpx rgba(158, 74, 42, 0); }
}

/* 锁定（locked）：灰玉节点 + 卡片降饱和，底部小锁 SVG */
.route-item.locked .route-card {
  box-shadow: none;
  border-color: var(--line);
  opacity: 0.72;
}
.route-item.locked .route-scale-name { color: var(--ink-muted); }

/* ============================================================
   空状态
   ============================================================ */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 48rpx;
}
.empty-seal {
  width: 96rpx;
  height: 110rpx;
  clip-path: polygon(15% 0, 85% 0, 100% 24%, 100% 62%, 50% 100%, 0 62%, 0 24%);
  background: linear-gradient(160deg, var(--line), var(--ochre));
  opacity: 0.5;
  margin-bottom: 24rpx;
}
.empty-title { font-size: var(--fs-h2); color: var(--ink-soft); letter-spacing: 3rpx; }
.empty-desc {
  font-size: var(--fs-small);
  color: var(--ink-muted);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}
