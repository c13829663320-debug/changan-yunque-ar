page { height: 100%; }

.splash {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(120% 80% at 50% 18%, rgba(255, 250, 238, 0.95), transparent 62%),
    radial-gradient(150% 120% at 50% 122%, rgba(158, 74, 42, 0.12), transparent 56%),
    linear-gradient(180deg, #f3e9d6 0%, #efe4cf 60%, #e8dcc4 100%);
  overflow: hidden;
}
/* 暗角 */
.splash::before {
  content: '';
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 190rpx rgba(110, 80, 50, 0.2);
  pointer-events: none;
}

.stage {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo：外层入场+光晕（不裁剪），内层裁剪高光扫过 */
.logo-aura {
  position: relative;
  width: 244rpx;
  height: 280rpx;
  opacity: 0;
  transform: scale(0.62) translateY(22rpx);
  animation: logoIn 0.95s cubic-bezier(0.2, 0.8, 0.25, 1) 0.15s forwards;
}
.logo-aura::before {
  content: '';
  position: absolute;
  inset: -40rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(198, 166, 104, 0.5), transparent 70%);
  z-index: -1;
  animation: glow 2.6s ease-in-out infinite;
}
.logo-clip {
  position: relative;
  width: 244rpx;
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.logo-clip::after {
  content: '';
  position: absolute;
  top: -30%;
  left: -70%;
  width: 48%;
  height: 160%;
  background: linear-gradient(100deg, transparent, rgba(255, 242, 205, 0.9), transparent);
  transform: skewX(-20deg);
  animation: sweep 1.7s ease 0.7s 1;
}
.logo { width: 244rpx; height: 280rpx; position: relative; z-index: 1; display: block; }

.title {
  margin-top: 34rpx;
  font-size: 62rpx;
  font-weight: 800;
  letter-spacing: 16rpx;
  color: #9e4a2a;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.6);
  opacity: 0;
  transform: translateY(18rpx);
  animation: rise 0.8s ease 0.85s forwards;
}
.slogan {
  margin-top: 18rpx;
  font-size: 26rpx;
  letter-spacing: 7rpx;
  color: #8a6a4a;
  opacity: 0;
  animation: fadeIn 0.8s ease 1.25s forwards;
}

/* 粒子 */
.particles { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
.particle {
  position: absolute;
  bottom: -24rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 176, 112, 0.95), rgba(212, 176, 112, 0));
  animation-name: floatUp;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.skip {
  position: absolute;
  right: 32rpx;
  bottom: 72rpx;
  z-index: 3;
  font-size: 24rpx;
  color: #9a8a72;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(150, 120, 80, 0.25);
  padding: 10rpx 26rpx;
  border-radius: 32rpx;
  opacity: 0;
  animation: fadeIn 0.6s ease 1.4s forwards;
}

@keyframes logoIn {
  to { opacity: 1; transform: scale(1) translateY(0); }
}
@keyframes glow {
  0%, 100% { opacity: 0.5; transform: scale(0.95); }
  50% { opacity: 0.95; transform: scale(1.06); }
}
@keyframes sweep {
  0% { left: -70%; }
  55%, 100% { left: 135%; }
}
@keyframes rise {
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  to { opacity: 1; }
}
@keyframes floatUp {
  0% { transform: translateY(0) scale(1); opacity: 0; }
  10% { opacity: 0.9; }
  90% { opacity: 0.6; }
  100% { transform: translateY(-106vh) scale(0.4); opacity: 0; }
}
