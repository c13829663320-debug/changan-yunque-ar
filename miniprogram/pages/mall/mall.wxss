/* 顶部：分类横滑 + 购物车入口 */
.mall-top { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.cat-bar { flex: 1; white-space: nowrap; }
.cat {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 14rpx;
  font-size: var(--fs-small);
  color: var(--ink-soft);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}
.cat.on { background: var(--cinnabar); color: #fbf3e4; border-color: var(--cinnabar); }

.cart-entry {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
}
.cart-entry-ico { font-size: 28rpx; color: var(--cinnabar); line-height: 1; }
.cart-entry-text { font-size: var(--fs-mini); color: var(--ink-soft); margin-top: 4rpx; }

/* 商品网格 */
.goods-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.grid-item { width: calc(50% - 10rpx); background: var(--bg-card); border: 1rpx solid var(--line); border-radius: var(--radius); padding: 16rpx; box-shadow: var(--shadow); }
.grid-cover {
  position: relative;
  height: 280rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(160deg, #ece1cd, #e0d2b8);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}
.grid-cover-img { width: 100%; height: 100%; }
.cover-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.cover-cat { font-size: var(--fs-small); color: var(--dark-gold); }
/* 分类角标 */
.grid-cat-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 14rpx;
  font-size: var(--fs-mini);
  color: #fbf3e4;
  background: rgba(70, 62, 54, 0.42);
  border-radius: 999rpx;
}
/* 文物灵感小标记 */
.grid-relic-mark {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 4rpx 12rpx;
  font-size: var(--fs-mini);
  color: #fbf3e4;
  background: var(--cinnabar);
  border: 1rpx solid #fbf3e4;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}
.grid-name { font-size: var(--fs-small); color: var(--ink); line-height: 1.4; height: 72rpx; overflow: hidden; display: block; }
.grid-price { font-size: var(--fs-body); color: var(--cinnabar); font-weight: 600; }
.presale-tag { font-size: var(--fs-mini); color: var(--ink-muted); border: 1rpx solid var(--line); border-radius: 999rpx; padding: 2rpx 14rpx; }

/* loading 骨架 */
.skeleton { padding: 16rpx; }
.sk-cover { height: 240rpx; border-radius: var(--radius-sm); background: linear-gradient(100deg, #e6dcc8 20%, #f0e8d6 40%, #e6dcc8 60%); background-size: 200% 100%; animation: shimmer 1.3s infinite; margin-bottom: 14rpx; }
.sk-line { height: 22rpx; border-radius: 8rpx; background: #e6dcc8; margin-bottom: 12rpx; }
.sk-line.w60 { width: 80%; }
.sk-line.w40 { width: 50%; }
@keyframes shimmer { to { background-position: -200% 0; } }

/* 空状态 */
.empty { padding-top: 180rpx; display: flex; flex-direction: column; align-items: center; }
.empty-ico { font-size: 80rpx; color: var(--line); margin-bottom: 20rpx; }
.empty-text { font-size: var(--fs-body); color: var(--ink-muted); margin-bottom: 30rpx; }
.empty-btn { width: 60%; }
