/* —— 商城列表页打磨：盛唐敦煌低饱和质感，克制留白与层级 —— */
.mall { padding-top: 8rpx; }

.mall-head { margin: 6rpx 4rpx 24rpx; }
.mall-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 3rpx;
  display: block;
}
.mall-sub {
  font-size: var(--fs-small);
  color: var(--ink-muted);
  margin-top: 8rpx;
  display: block;
  letter-spacing: 1rpx;
}

/* 分类筛选：选中=深墨 pill，未选=卡纸描边 pill */
.cat-bar { white-space: nowrap; margin-bottom: 28rpx; }
.cat {
  display: inline-flex;
  align-items: center;
  padding: 13rpx 32rpx;
  margin-right: 16rpx;
  font-size: var(--fs-small);
  color: var(--ink-soft);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
}
.cat.on {
  background: var(--ink);
  color: var(--ivory);
  border-color: var(--ink);
  font-weight: 600;
}

/* 商品双列卡 */
.goods-grid { display: flex; flex-wrap: wrap; gap: 22rpx; }
.grid-item {
  width: calc(50% - 11rpx);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
  animation: mallFadeUp 0.5s ease backwards;
}
.grid-cover {
  position: relative;
  height: 300rpx;
  background: linear-gradient(160deg, var(--ivory-deep), var(--bg-card-deep));
  overflow: hidden;
}
.grid-cover-img { width: 100%; height: 100%; }
.grid-cover-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-cat { font-size: var(--fs-small); color: var(--dark-gold); letter-spacing: 3rpx; }
.cover-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 90rpx;
  background: linear-gradient(180deg, transparent, rgba(70, 62, 54, 0.18));
  pointer-events: none;
}
.cover-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 5rpx 16rpx;
  font-size: var(--fs-mini);
  color: var(--ivory);
  background: rgba(158, 74, 42, 0.88);
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}

.grid-info { padding: 18rpx 20rpx 22rpx; }
.grid-name {
  font-size: var(--fs-small);
  color: var(--ink);
  font-weight: 600;
  line-height: 1.45;
  height: 66rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.grid-desc {
  font-size: var(--fs-mini);
  color: var(--ink-muted);
  line-height: 1.5;
  margin-top: 6rpx;
  height: 30rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  display: block;
}
.grid-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
}
.grid-price { font-size: 34rpx; color: var(--cinnabar); font-weight: 700; }
.grid-price-symbol { font-size: var(--fs-small); font-weight: 600; margin-right: 2rpx; }

@keyframes mallFadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
