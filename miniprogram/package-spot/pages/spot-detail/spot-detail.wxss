/* ===== 景点数字馆模板页 · 复用全局 token，不新造色板 ===== */

.body { padding-top: 0; }
.spot-detail { background: var(--bg); min-height: 100vh; }

/* ---------- 1. 头图 ---------- */
.hero { position: relative; width: 100%; height: 560rpx; overflow: hidden; background: var(--ivory-deep); }
.hero-cover { width: 100%; height: 100%; display: block; }
.hero-shade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 78%;
  background: linear-gradient(180deg, rgba(46, 36, 26, 0) 0%, rgba(46, 36, 26, 0.62) 100%);
}
.hero-inner { position: absolute; left: 0; right: 0; bottom: 0; padding: 32rpx 34rpx 36rpx; }
.hero-city {
  display: inline-block; font-size: 20rpx; color: #f4ecdd;
  background: rgba(251, 246, 236, 0.16); border: 1rpx solid rgba(251, 246, 236, 0.3);
  padding: 4rpx 18rpx; border-radius: 999rpx; margin-bottom: 16rpx;
}
.hero-name {
  font-size: 46rpx; font-weight: 700; color: #fbf6ec; letter-spacing: 2rpx; display: block;
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.35);
}
.hero-sub { font-size: 26rpx; color: rgba(251, 246, 236, 0.92); margin-top: 10rpx; display: block; }
.hero-tags { margin-top: 18rpx; display: flex; flex-wrap: wrap; }
.hero-tags .tag { color: #f4ecdd; background: rgba(251, 246, 236, 0.18); border: 1rpx solid rgba(251, 246, 236, 0.28); }

/* ---------- 概览 + 关键事实 ---------- */
.para { display: block; margin-top: 14rpx; }
.stats { display: flex; margin-top: 22rpx; background: var(--bg-card-deep); border-radius: var(--radius); padding: 18rpx 0; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid var(--line); }
.stat:last-child { border-right: none; }
.stat-value { font-size: 28rpx; font-weight: 700; color: var(--cinnabar); }
.stat-label { font-size: 20rpx; color: var(--ink-muted); margin-top: 6rpx; }

/* ---------- 2. 历史沿革时间线（圆点与轴线像素级对齐） ---------- */
.tl-group { margin-top: 10rpx; }
.tl-era {
  display: inline-block; font-size: 22rpx; font-weight: 600; color: var(--dark-gold);
  background: rgba(168, 137, 58, 0.12); padding: 6rpx 20rpx; border-radius: 999rpx; margin: 18rpx 0 8rpx;
}
.tl-item {
  display: grid; grid-template-columns: 30rpx 1fr; column-gap: 18rpx;
  padding-bottom: 30rpx;
}
.tl-axis { position: relative; }
.tl-dot {
  position: absolute; left: 50%; top: 8rpx; width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--cinnabar); border: 3rpx solid var(--bg-card);
  box-shadow: 0 0 0 5rpx rgba(158, 74, 42, 0.12); transform: translateX(-50%);
}
.tl-axis::before {
  content: ''; position: absolute; left: 50%; top: 26rpx; bottom: -30rpx; width: 2rpx;
  transform: translateX(-50%); background: var(--line);
}
.tl-item:last-child .tl-axis::before { display: none; }
.tl-year { font-size: 22rpx; color: var(--dark-gold); font-weight: 600; }
.tl-title { font-size: 27rpx; color: var(--ink); font-weight: 600; display: block; margin: 6rpx 0; }
.tl-img { width: 100%; border-radius: var(--radius-sm); margin: 10rpx 0; display: block; }
.tl-desc { font-size: 23rpx; color: var(--ink-muted); line-height: 1.7; display: block; }

/* ---------- 3. 动线 SVG 示意图 ---------- */
.route-canvas {
  position: relative; width: 100%; height: 580rpx; margin-top: 18rpx;
  border-radius: var(--radius); overflow: hidden;
  background: var(--bg-card-deep); border: 1rpx solid var(--line);
}
.route-svg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.zone-label {
  position: absolute; transform: translate(4%, 8%); font-size: 18rpx; color: var(--ink-muted);
  opacity: 0.75; pointer-events: none; white-space: nowrap;
}
.edge-label {
  position: absolute; transform: translate(-50%, -50%); font-size: 18rpx; color: var(--cinnabar);
  background: rgba(251, 246, 236, 0.88); padding: 2rpx 12rpx; border-radius: 6rpx;
  white-space: nowrap; pointer-events: none;
}
.route-node { position: absolute; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; }
.route-dot {
  width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--cinnabar);
  border: 3rpx solid #fff; box-shadow: 0 2rpx 8rpx rgba(90, 74, 50, 0.35);
}
.route-node.is-link .route-dot { background: var(--dark-gold); }
.route-node-label {
  margin-top: 8rpx; background: rgba(251, 246, 236, 0.94); padding: 4rpx 14rpx;
  border-radius: 8rpx; text-align: center; box-shadow: var(--shadow); white-space: nowrap;
}
.route-node-name { font-size: 20rpx; color: var(--ink); font-weight: 600; display: block; }
.route-node-role { font-size: 16rpx; color: var(--ink-muted); display: block; margin-top: 2rpx; }
.route-note { font-size: 20rpx; color: var(--ink-muted); margin-top: 16rpx; display: block; }

/* ---------- 4. 必看亮点 ---------- */
.hl-grid { margin-top: 18rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.hl-card { background: var(--bg-card-deep); border-radius: var(--radius); overflow: hidden; }
.hl-media { position: relative; width: 100%; height: 180rpx; }
.hl-img { width: 100%; height: 100%; }
.hl-tag {
  position: absolute; left: 12rpx; top: 12rpx; font-size: 18rpx; color: #fbf6ec;
  background: rgba(158, 74, 42, 0.85); padding: 3rpx 14rpx; border-radius: 999rpx;
}
.hl-name { font-size: 24rpx; font-weight: 600; color: var(--ink); padding: 14rpx 16rpx 0; display: block; }
.hl-desc { font-size: 20rpx; color: var(--ink-muted); line-height: 1.6; padding: 8rpx 16rpx 18rpx; display: block; }

/* ---------- 5. 关联剧场 ---------- */
.theater-card {
  display: flex; margin-top: 18rpx; background: var(--bg-card-deep);
  border-radius: var(--radius); overflow: hidden; border: 1rpx solid var(--line);
}
.theater-img { width: 200rpx; height: 156rpx; flex-shrink: 0; }
.theater-info { flex: 1; padding: 16rpx 18rpx; display: flex; flex-direction: column; }
.theater-name { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.theater-scale { font-size: 20rpx; color: var(--dark-gold); margin-top: 6rpx; }
.theater-sub { font-size: 20rpx; color: var(--ink-muted); line-height: 1.5; margin-top: 8rpx; flex: 1; }
.theater-cta { display: flex; align-items: center; margin-top: 10rpx; font-size: 22rpx; color: var(--cinnabar); font-weight: 600; }
.theater-arrow { margin-left: 8rpx; }

/* ---------- 6. 史料引用 ---------- */
.cite { padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.cite:last-child { border-bottom: none; }
.cite-head { display: flex; align-items: center; }
.cite-kind {
  font-size: 18rpx; color: var(--azurite-deep); background: rgba(143, 166, 171, 0.16);
  padding: 3rpx 12rpx; border-radius: 6rpx; margin-right: 12rpx;
}
.cite-work { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.cite-chapter { font-size: 22rpx; color: var(--ink-soft); margin-top: 8rpx; display: block; }
.cite-quote {
  font-size: 22rpx; color: var(--ink); line-height: 1.7; margin-top: 10rpx;
  padding: 12rpx 16rpx; background: var(--bg-card-deep);
  border-left: 4rpx solid var(--ochre-deep); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; display: block;
}
.cite-note { font-size: 20rpx; color: var(--ink-muted); line-height: 1.6; margin-top: 8rpx; display: block; }
.cite-url { font-size: 20rpx; color: var(--azurite-deep); margin-top: 8rpx; display: inline-block; }

/* ---------- 到访信息 ---------- */
.info-row { display: flex; padding: 10rpx 0; }
.info-k { width: 80rpx; font-size: 24rpx; color: var(--ink-muted); flex-shrink: 0; }
.info-v { flex: 1; font-size: 24rpx; color: var(--ink-soft); line-height: 1.6; }

/* ---------- CTA / 文创 ---------- */
.start-tour { margin: 8rpx 0 28rpx; }
.related { margin-bottom: 24rpx; }
.rel-scroll { white-space: nowrap; margin-top: 16rpx; }
.rel-item { display: inline-flex; flex-direction: column; width: 200rpx; margin-right: 16rpx; vertical-align: top; }
.rel-cover { height: 200rpx; border-radius: var(--radius); overflow: hidden; margin-bottom: 10rpx; }
.rel-cover image { width: 100%; height: 100%; }
.rel-name { font-size: 20rpx; color: var(--ink); white-space: normal; height: 56rpx; }
.rel-price { font-size: 20rpx; color: var(--cinnabar); margin-top: 4rpx; }

/* ---------- 缺失兜底 ---------- */
.fallback { min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60rpx; }
.fallback-icon {
  width: 128rpx; height: 128rpx; border-radius: 50%; background: var(--bg-card-deep);
  border: 2rpx solid var(--dark-gold-soft); display: flex; align-items: center; justify-content: center;
}
.fallback-icon text { font-size: 52rpx; color: var(--dark-gold); }
.fallback-title { font-size: 32rpx; font-weight: 600; color: var(--ink); margin-top: 28rpx; }
.fallback-desc { font-size: 24rpx; color: var(--ink-muted); text-align: center; line-height: 1.7; margin-top: 14rpx; }
.fallback-btn { margin-top: 36rpx; width: 60%; }
