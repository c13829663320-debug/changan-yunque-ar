<view class="spot-detail" wx:if="{{spot}}">
  <view class="hero">
    <text class="hero-name">{{spot.name}}</text>
    <text class="hero-sub">{{spot.subtitle}}</text>
    <view class="hero-tags">
      <text class="tag tag-gold" wx:for="{{spot.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="page-wrap body">
    <view class="card">
      <text class="title-h2">景点概览</text>
      <text class="text-body para">{{spot.summary}}</text>
    </view>

    <view class="card">
      <text class="title-h2">历史时间线</text>
      <view class="timeline">
        <view class="tl-item" wx:for="{{spot.timeline}}" wx:key="year">
          <view class="tl-dot"></view>
          <view class="tl-content">
            <text class="tl-year">{{item.year}}</text>
            <text class="tl-title">{{item.title}}</text>
            <text class="tl-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="title-h2">主要看点</text>
      <view class="relic" wx:for="{{spot.relics}}" wx:key="name">
        <text class="relic-name">{{item.name}}</text>
        <text class="relic-desc">{{item.desc}}</text>
      </view>
    </view>

    <view class="card">
      <text class="title-h2">到访信息</text>
      <text class="info-line">开放：{{spot.openInfo.hours}}</text>
      <text class="info-line">门票：{{spot.openInfo.ticket}}</text>
      <text class="info-line">交通：{{spot.openInfo.traffic}}</text>
    </view>

    <button class="btn-primary start-tour" bindtap="startTour">跟随云阙巡游大明宫</button>

    <view class="related">
      <text class="title-h2">相关文创</text>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="rel-scroll">
        <view class="rel-item" wx:for="{{relatedGoods}}" wx:key="id" data-id="{{item.id}}" bindtap="goGoods">
          <view class="rel-cover"><text>{{item.categoryLabel}}</text></view>
          <text class="rel-name">{{item.name}}</text>
          <text class="rel-price">¥{{item.price}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
