<view class="goods-detail" wx:if="{{goods}}">
  <view class="gd-cover"><text class="gd-cat">{{categoryLabel}}</text></view>

  <view class="page-wrap gd-body">
    <view class="gd-head card">
      <text class="gd-name">{{goods.name}}</text>
      <view class="gd-price-row">
        <text class="gd-price">¥{{goods.price}}</text>
        <text class="gd-presale">预售 · 意向登记</text>
      </view>
      <view class="gd-tags">
        <text class="tag" wx:for="{{goods.tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="card">
      <text class="title-h2">商品介绍</text>
      <text class="text-body para">{{goods.desc}}</text>
    </view>

    <view class="card" wx:if="{{goods.culturalNote}}">
      <text class="title-h2">文物灵感</text>
      <text class="text-body para">{{goods.culturalNote}}</text>
    </view>

    <button class="btn-ghost ar-btn" bindtap="previewAR" wx:if="{{goods.arPreview}}">AR 预览 / 扫描召唤</button>
  </view>

  <!-- AR 预览层 -->
  <view class="ar-mask" wx:if="{{showAR}}" bindtap="closeAR">
    <view class="ar-frame" catchtap="noop">
      <view class="ar-object"></view>
      <text class="ar-title">AR 预览</text>
      <text class="ar-tip">{{arTip}}</text>
      <button class="btn-primary ar-done" catchtap="closeAR">完成预览</button>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="gd-bar">
    <view class="bar-side" bindtap="goCart"><text class="side-text">购物车</text></view>
    <button class="bar-cart" bindtap="addCart">加入购物车</button>
    <button class="bar-buy" bindtap="registerIntention">预售登记</button>
  </view>
</view>
