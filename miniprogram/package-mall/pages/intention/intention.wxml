<view class="page-wrap intention">
  <!-- 顶部说明：预售/意向登记，仅登记不交易 -->
  <view class="card banner">
    <text class="banner-title">预售 · 意向登记</text>
    <text class="banner-sub">开售优先通知，当前暂不扣款。</text>
  </view>

  <!-- 待提交态：表单 + 意向商品 -->
  <block wx:if="{{mode === 'form'}}">
    <view class="card form-card">
      <text class="form-title">留下联系方式</text>
      <view class="field">
        <text class="field-label">联系人</text>
        <input class="field-input" placeholder="怎么称呼你（必填）" value="{{name}}" bindinput="onName" />
      </view>
      <view class="field">
        <text class="field-label">手机号</text>
        <input class="field-input" type="number" maxlength="11" placeholder="11位手机号，用于开售提醒（必填）" value="{{phone}}" bindinput="onPhone" />
      </view>
      <view class="field">
        <text class="field-label">备注</text>
        <input class="field-input" placeholder="选填，如规格 / 数量偏好" value="{{remark}}" bindinput="onRemark" />
      </view>
    </view>

    <view class="card list-card">
      <text class="form-title">意向商品（{{pendingRows.length}}）</text>
      <view class="int-item" wx:for="{{pendingRows}}" wx:key="id">
        <image class="ii-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="ii-info">
          <text class="ii-name">{{item.name}}</text>
          <text class="ii-price">¥{{item.price}} × {{item.qty}}</text>
        </view>
        <text class="ii-subtotal">¥{{item.subtotal}}</text>
      </view>
      <view class="total-row">
        <text class="total-label">合计（意向 · 暂不扣款）</text>
        <text class="total-value">¥{{pendingTotal}}</text>
      </view>
    </view>

    <button class="btn-primary submit-btn" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">
      提交意向登记
    </button>
  </block>

  <!-- 历史查看态 -->
  <block wx:elif="{{mode === 'history'}}">
    <view class="card hist-card" wx:for="{{history}}" wx:key="key">
      <view class="hist-head">
        <text class="hist-name">{{item.name}}</text>
        <view class="hist-tags">
          <text class="tag tag-gold">{{item.sourceLabel}}</text>
          <text class="tag tag-cinnabar">{{item.statusText}}</text>
        </view>
      </view>
      <view class="hist-items">
        <text class="hist-item" wx:for="{{item.itemLines}}" wx:for-item="line" wx:key="*this">{{line}}</text>
      </view>
      <view class="hist-meta">
        <text class="hist-phone">{{item.phoneMasked}}</text>
        <text class="hist-time">{{item.timeText}}</text>
      </view>
    </view>

    <button class="btn-ghost clear-btn" bindtap="clear">清空意向单</button>
  </block>

  <!-- 空状态 -->
  <view class="card empty-card" wx:else>
    <text class="empty-title">暂无预售/意向登记</text>
    <text class="empty-sub">去商城看看感兴趣的预售商品，开售我们会优先通知你。</text>
    <button class="btn-primary empty-btn" bindtap="goMall">去商城逛逛</button>
  </view>
</view>
