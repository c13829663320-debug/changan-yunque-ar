.marker-layer {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

.ar-canvas {
  width: 100vw;
  height: 100vh;
}

/* ===== 模拟路径 ===== */
.sim-stage {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.sim-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.sim-bg-gradient {
  background: linear-gradient(180deg, #2b2418 0%, #4a3b22 55%, #6b5636 100%);
}

.sim-hint {
  position: absolute;
  left: 50%;
  bottom: 140rpx;
  transform: translateX(-50%);
  max-width: 80%;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #f4ecdd;
  font-size: 26rpx;
  text-align: center;
}

.sim-restore {
  position: absolute;
  left: 50%;
  bottom: 120rpx;
  width: 86%;
  transform: translateX(-50%) translateY(40rpx);
  opacity: 0;
  transition: opacity 0.6s ease, transform 0.6s ease;
  filter: drop-shadow(0 8rpx 24rpx rgba(0, 0, 0, 0.45));
}

.sim-restore-in {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
