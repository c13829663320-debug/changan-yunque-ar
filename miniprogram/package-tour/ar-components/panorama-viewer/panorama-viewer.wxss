/* panorama-viewer：全屏环视层 + 光影叠加 */
.pv {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 24rpx;
  background: #1c1a17;
}

.pv-stage {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

/* ===== 第 1 级 XRFrame ===== */
.pv-xr {
  width: 100%;
  height: 100%;
}

/* ===== 第 2 级 全景图 ===== */
.pv-pano-track {
  position: absolute;
  top: 50%;
  left: 0;
  width: 200%; /* 与 _panoW = screenW*2 对应 */
  transform: translateY(-50%);
  will-change: transform;
}
.pv-pano-img {
  width: 100%;
  display: block;
}

/* ===== 第 3 级 复原图 ===== */
.pv-restore-track {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  padding: 0 4%;
  box-sizing: border-box;
  transform: translateY(-50%);
  will-change: transform;
}
.pv-restore-img {
  width: 100%;
  display: block;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35);
}

/* ===== 兜底 CSS 殿宇 ===== */
.pv-static {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #2a2723 0%, #4a3f30 60%, #6b563a 100%);
}
.pv-palace {
  position: relative;
  width: 320rpx;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.pv-roof {
  width: 300rpx;
  height: 70rpx;
  background: linear-gradient(180deg, #b08d68, #c7a987);
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}
.pv-body {
  width: 220rpx;
  height: 140rpx;
  background: repeating-linear-gradient(90deg, #d8c4a4 0 20rpx, #cdb690 20rpx 40rpx);
  border: 1rpx solid #b08d68;
}
.pv-base {
  width: 300rpx;
  height: 24rpx;
  background: #b08d68;
  border-radius: 4rpx;
}

/* ===== 光影叠加：晨昏暖色渐变（时间光照） ===== */
.pv-light {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(255, 196, 120, 0.28) 0%,
    rgba(255, 150, 80, 0.10) 38%,
    rgba(40, 30, 60, 0.22) 100%
  );
  mix-blend-mode: soft-light;
}
.pv-light-soft {
  background: linear-gradient(
    180deg,
    rgba(255, 210, 150, 0.22) 0%,
    rgba(120, 90, 60, 0.12) 100%
  );
}

/* 扫光：一道柔光横向扫过（带光影） */
.pv-sweep {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -40%;
  width: 40%;
  pointer-events: none;
  background: linear-gradient(
    100deg,
    transparent 0%,
    rgba(255, 236, 190, 0.22) 45%,
    rgba(255, 255, 255, 0.30) 50%,
    rgba(255, 236, 190, 0.22) 55%,
    transparent 100%
  );
  animation: pv-sweep-move 7s ease-in-out infinite;
}
.pv-sweep-slow {
  animation-duration: 11s;
  width: 30%;
}
@keyframes pv-sweep-move {
  0% { left: -40%; }
  50% { left: 100%; }
  100% { left: -40%; }
}

/* 暗角，增强沉浸 */
.pv-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  box-shadow: inset 0 0 120rpx rgba(0, 0, 0, 0.45);
}

/* ===== 状态与操作 ===== */
.pv-status {
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  max-width: 80%;
  font-size: 22rpx;
  color: #f4ecdd;
  background: rgba(0, 0, 0, 0.45);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pv-ui {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 100%);
}
.pv-hint {
  font-size: 22rpx;
  color: #f4ecdd;
  text-align: center;
  letter-spacing: 1rpx;
}
.pv-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 72rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  color: #f4ecdd;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
  padding: 0;
  margin: 0;
}
.pv-close::after { border: none; }
.pv-continue {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(90deg, #a65a2c, #c27a3a);
}
.pv-continue::after { border: none; }
