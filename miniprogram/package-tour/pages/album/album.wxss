.album-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f6efe1 0%, #f1e8d6 100%);
  padding-bottom: 60rpx;
}

/* 头部 */
.album-head { padding: 40rpx 40rpx 28rpx; }
.album-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #a9803a;
  margin-bottom: 12rpx;
}
.album-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #2b2620;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.album-progress {
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(154, 120, 60, 0.16);
  overflow: hidden;
}
.album-progress-bar {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #c79a4b, #9e3b2e);
  transition: width 0.6s ease;
}
.album-progress-text {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6b5e48;
}

/* 网格 */
.album-grid { display: flex; flex-wrap: wrap; padding: 8rpx 28rpx; }
.relic-cell { width: 50%; box-sizing: border-box; padding: 12rpx; }
.relic-thumb {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #e8dfcc;
  box-shadow: 0 6rpx 20rpx rgba(60, 40, 15, 0.08);
}
.relic-thumb-img { width: 100%; height: 100%; }
.relic-lock {
  position: absolute;
  inset: 0;
  background: rgba(40, 32, 22, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
}
.relic-lock-glyph {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 2rpx solid rgba(244, 236, 221, 0.7);
  border-radius: 50%;
  color: #f4ecdd;
  font-size: 26rpx;
}
.relic-cell.locked .relic-thumb-img { filter: grayscale(1) brightness(0.8); }
.relic-name {
  display: block;
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #2b2620;
}
.relic-name.dim { color: #9a8e78; }
.relic-era {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a7b60;
}

/* 提示 */
.album-tip {
  margin: 28rpx 40rpx 0;
  padding: 26rpx 28rpx;
  background: rgba(255, 253, 248, 0.7);
  border: 1rpx solid rgba(154, 120, 60, 0.18);
  border-radius: 18rpx;
}
.album-tip-text { display: block; font-size: 24rpx; line-height: 1.7; color: #6b5e48; }
.album-scan-btn {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #9e3b2e, #7e2c22);
  color: #f6eedd;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(126, 44, 34, 0.28);
}
.album-scan-btn::after { border: none; }

/* 详情弹层 */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(30, 22, 14, 0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.detail-sheet {
  width: 100%;
  height: 88vh;
  background: #fbf6ec;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: sheetUp 0.32s cubic-bezier(0.22, 0.8, 0.3, 1);
}
@keyframes sheetUp {
  from { transform: translateY(60rpx); opacity: 0.4; }
  to { transform: translateY(0); opacity: 1; }
}
.detail-banner { position: relative; height: 380rpx; flex-shrink: 0; }
.detail-banner-img { width: 100%; height: 100%; }
.detail-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(30, 22, 14, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-close-glyph { color: #f6eedd; font-size: 28rpx; }
.detail-banner-meta {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 32rpx 24rpx;
  background: linear-gradient(180deg, transparent, rgba(30, 22, 14, 0.72));
}
.detail-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #fbf4e4;
  letter-spacing: 2rpx;
}
.detail-era {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: rgba(246, 238, 221, 0.85);
}

.detail-scroll { flex: 1; padding: 28rpx 32rpx 48rpx; box-sizing: border-box; }
.detail-line {
  position: relative;
  padding: 16rpx 0 16rpx 28rpx;
  border-left: 3rpx solid rgba(158, 59, 46, 0.4);
  margin-left: 8rpx;
}
.detail-line-text { font-size: 27rpx; line-height: 1.75; color: #3a322a; }
.detail-arch {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(154, 120, 60, 0.18);
  border-radius: 16rpx;
}
.detail-arch-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #9e3b2e;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}
.detail-arch-text { font-size: 25rpx; line-height: 1.8; color: #4a4034; }
.detail-note {
  margin-top: 18rpx;
  padding: 16rpx 22rpx;
  background: rgba(158, 59, 46, 0.07);
  border-radius: 12rpx;
}
.detail-note-text { font-size: 22rpx; line-height: 1.6; color: #8a5a48; }
.detail-source {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  background: rgba(184, 137, 62, 0.08);
  border-radius: 16rpx;
}
.detail-source-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #a9803a;
  margin-bottom: 14rpx;
}
.detail-source-work { margin-bottom: 12rpx; }
.detail-source-name { display: block; font-size: 24rpx; font-weight: 600; color: #5a4a30; }
.detail-source-quote {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #6b5e48;
}
.detail-source-note {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8a7b60;
}
.detail-mall-btn {
  margin-top: 26rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #c79a4b, #a9762e);
  color: #fbf4e4;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(169, 118, 46, 0.28);
}
.detail-mall-btn::after { border: none; }
