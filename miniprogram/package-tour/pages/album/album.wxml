<view class="album-page">
  <view class="album-head">
    <text class="album-kicker">长安遗珍 · 现场收录</text>
    <text class="album-title">文物图鉴</text>
    <view class="album-progress">
      <view class="album-progress-bar" style="width: {{total ? (gotCount * 100 / total) : 0}}%;"></view>
    </view>
    <text class="album-progress-text">已收录 {{gotCount}} / {{total}} 件</text>
  </view>

  <view class="album-grid">
    <view
      class="relic-cell {{item.got ? '' : 'locked'}}"
      wx:for="{{cells}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapCell"
    >
      <view class="relic-thumb">
        <image class="relic-thumb-img" src="{{item.image}}" mode="aspectFill"></image>
        <view wx:if="{{!item.got}}" class="relic-lock">
          <text class="relic-lock-glyph">锁</text>
        </view>
      </view>
      <text class="relic-name {{item.got ? '' : 'dim'}}">{{item.name}}</text>
      <text class="relic-era">{{item.era}}</text>
    </view>
  </view>

  <view class="album-tip">
    <text class="album-tip-text">到大明宫遗址现场，用「现场巡游」扫描文物即可收录；收录后可查看云阙讲解、文物档案与可溯源史料。</text>
    <button class="album-scan-btn" bindtap="goScan">去现场扫描</button>
  </view>

  <!-- 详情弹层 -->
  <view wx:if="{{detail}}" class="detail-mask" bindtap="closeDetail">
    <view class="detail-sheet" catchtap="noop">
      <view class="detail-banner">
        <image class="detail-banner-img" src="{{detail.image}}" mode="aspectFill"></image>
        <view class="detail-close" bindtap="closeDetail"><text class="detail-close-glyph">✕</text></view>
        <view class="detail-banner-meta">
          <text class="detail-name">{{detail.name}}</text>
          <text class="detail-era">{{detail.era}}</text>
        </view>
      </view>

      <scroll-view scroll-y class="detail-scroll" enhanced show-scrollbar="{{false}}">
        <view class="detail-lines">
          <view class="detail-line" wx:for="{{lines}}" wx:key="*this">
            <text class="detail-line-text">{{item}}</text>
          </view>
        </view>

        <view class="detail-arch">
          <text class="detail-arch-title">文物档案</text>
          <text class="detail-arch-text">{{detail.intro}}</text>
        </view>

        <view wx:if="{{detail.culturalNote}}" class="detail-note">
          <text class="detail-note-text">{{detail.culturalNote}}</text>
        </view>

        <view wx:if="{{detail.sourceCard}}" class="detail-source">
          <text class="detail-source-title">{{detail.sourceCard.title}}</text>
          <view class="detail-source-work" wx:for="{{detail.sourceCard.works}}" wx:for-item="w" wx:key="name">
            <text class="detail-source-name">《{{w.name}}》</text>
            <text wx:if="{{w.quote}}" class="detail-source-quote">{{w.quote}}</text>
          </view>
          <text class="detail-source-note">{{detail.sourceCard.note}}</text>
        </view>

        <button wx:if="{{detail.goodsId}}" class="detail-mall-btn" bindtap="onViewGoods">商城查看复刻 ›</button>
      </scroll-view>
    </view>
  </view>
</view>
