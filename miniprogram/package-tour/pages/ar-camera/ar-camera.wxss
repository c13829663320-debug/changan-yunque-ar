.ar-cam { position: relative; width: 100%; height: 100vh; overflow: hidden; }
.cam { position: absolute; inset: 0; width: 100%; height: 100%; }

.cam-top {
  position: absolute; top: calc(30rpx + env(safe-area-inset-top)); left: 30rpx; right: 30rpx;
  background: rgba(251, 246, 236, 0.92);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  text-align: center;
}
.cam-title { font-size: var(--fs-body); color: var(--ink); font-weight: 600; display: block; }
.cam-tip { font-size: var(--fs-mini); color: var(--ink-muted); display: block; margin-top: 6rpx; }

.cam-overlay {
  position: absolute; left: 0; right: 0; top: 30%;
  display: flex; flex-direction: column; align-items: center;
}
.overlay-palace { display: flex; flex-direction: column; align-items: center; opacity: 0.92; }
.ov-roof {
  width: 360rpx; height: 90rpx;
  background: linear-gradient(180deg, rgba(176,141,104,0.95), rgba(199,169,135,0.9));
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}
.ov-body {
  width: 260rpx; height: 160rpx;
  background: repeating-linear-gradient(90deg, rgba(216,196,164,0.9) 0 24rpx, rgba(205,182,144,0.9) 24rpx 48rpx);
  border: 1rpx solid rgba(176,141,104,0.9);
}
.ov-label {
  margin-top: 18rpx;
  font-size: var(--fs-small);
  color: #fbf3e4;
  background: rgba(70,62,54,0.6);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.cam-bottom {
  position: absolute; left: 30rpx; right: 30rpx; bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex; flex-direction: column; align-items: center;
}
.detect-btn { width: 100%; }
.vk-status { font-size: var(--fs-mini); color: rgba(251,246,236,0.85); margin-top: 16rpx; text-align:center; line-height:1.6; }
