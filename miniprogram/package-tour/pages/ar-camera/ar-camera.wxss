.ar-cam { position: fixed; inset: 0; background: #1a1714; }
.cam { position: absolute; inset: 0; width: 100%; height: 100%; }

/* 无可用相机时的内容底图（慢推 Ken Burns，模拟现场取景氛围） */
.scan-bg {
  position: absolute; inset: 0; width: 100%; height: 100%;
  animation: scanBgPush 24s ease-in-out infinite alternate;
}
@keyframes scanBgPush { from { transform: scale(1.04); } to { transform: scale(1.16); } }
/* 暗角：压暗四边，保证取景框 / 顶部标题 / 底部按钮文字可读 */
.scan-vignette {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(120% 90% at 50% 46%, transparent 42%, rgba(15, 11, 8, 0.62) 100%),
    linear-gradient(180deg, rgba(15, 11, 8, 0.45), transparent 26%, transparent 74%, rgba(15, 11, 8, 0.55));
}

/* 左上角退出按钮 */
.exit-btn {
  position: absolute; top: calc(env(safe-area-inset-top) + 18rpx); left: 28rpx; z-index: 20;
  display: flex; align-items: center; background: rgba(20, 16, 12, 0.4);
  padding: 12rpx 22rpx; border-radius: 40rpx;
}
.exit-glyph { font-size: 24rpx; color: #fff; line-height: 1; }
.exit-label { font-size: 24rpx; color: #fff; margin-left: 8rpx; }
.exit-btn.on-light { background: rgba(120, 96, 64, 0.12); }
.exit-btn.on-light .exit-glyph, .exit-btn.on-light .exit-label { color: #6a563c; }

/* 顶部 */
.cam-top {
  position: absolute; top: 0; left: 0; right: 0;
  padding: calc(env(safe-area-inset-top) + 30rpx) 40rpx 64rpx;
  background: linear-gradient(180deg, rgba(20, 16, 12, 0.58), transparent);
  display: flex; flex-direction: column; align-items: center;
}
.cam-kicker { font-size: 22rpx; letter-spacing: 4rpx; color: rgba(255, 240, 215, 0.85); }
.cam-title {
  font-size: 40rpx; font-weight: 700; color: #fff; margin-top: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}
.cam-era {
  font-size: 22rpx; color: rgba(255, 236, 205, 0.92); margin-top: 8rpx;
  background: rgba(216, 168, 106, 0.22); padding: 5rpx 18rpx; border-radius: 24rpx;
}

/* 取景框 */
.reticle { position: absolute; top: 50%; left: 50%; width: 520rpx; height: 520rpx; transform: translate(-50%, -56%); }
.reticle-corner { position: absolute; width: 54rpx; height: 54rpx; border: 4rpx solid rgba(255, 235, 200, 0.92); }
.tl { top: 0; left: 0; border-right: 0; border-bottom: 0; border-top-left-radius: 16rpx; }
.tr { top: 0; right: 0; border-left: 0; border-bottom: 0; border-top-right-radius: 16rpx; }
.bl { bottom: 0; left: 0; border-right: 0; border-top: 0; border-bottom-left-radius: 16rpx; }
.br { bottom: 0; right: 0; border-left: 0; border-top: 0; border-bottom-right-radius: 16rpx; }
.reticle.busy .reticle-corner { border-color: #d8a86a; }

.scan-line {
  position: absolute; left: 8rpx; right: 8rpx; height: 4rpx; border-radius: 4rpx;
  background: linear-gradient(90deg, transparent, #ecc88a, transparent);
  box-shadow: 0 0 18rpx rgba(236, 200, 138, 0.9);
  animation: scanMove 2s ease-in-out infinite;
}
@keyframes scanMove { 0%, 100% { top: 6%; } 50% { top: 94%; } }

.reticle-spin {
  position: absolute; top: 50%; left: 50%; width: 80rpx; height: 80rpx; margin: -40rpx 0 0 -40rpx;
  border: 5rpx solid rgba(216, 168, 106, 0.25); border-top-color: #d8a86a; border-radius: 50%;
  animation: rot 0.9s linear infinite;
}
@keyframes rot { to { transform: rotate(360deg); } }

/* ===== 识别命中：走龙 · 龙鳞鎏金动效（纯内联 SVG/CSS，复用 --dark-gold/--grad-gold/--cinnabar） ===== */
.dragon-fx {
  position: absolute; top: 50%; left: 50%; width: 260rpx; height: 260rpx;
  margin: -130rpx 0 0 -130rpx; pointer-events: none;
}
/* 光晕呼吸 */
.df-halo {
  position: absolute; inset: 0; border-radius: 50%;
  background: radial-gradient(circle, rgba(226, 180, 116, 0.42) 0%, rgba(216, 168, 106, 0.16) 46%, transparent 70%);
  animation: dfHalo 1.3s ease-in-out infinite;
}
@keyframes dfHalo { 0%, 100% { transform: scale(0.72); opacity: 0.55; } 50% { transform: scale(1.06); opacity: 1; } }
/* 旋转金环 */
.df-ring {
  position: absolute; inset: 46rpx; border-radius: 50%;
  border: 2rpx solid rgba(216, 168, 106, 0.55); border-top-color: #fff2d6; border-right-color: rgba(232, 201, 135, 0.15);
  animation: rot 0.9s linear infinite;
}
/* 走龙：内联 SVG 鎏金曲线 + 龙首珠，自绘缩放/流光 */
.df-dragon {
  position: absolute; inset: 0; background-position: center; background-repeat: no-repeat;
  background-image: url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%3E%3Cpath%20d%3D%22M22%2074C34%2060%2030%2044%2048%2040C66%2036%2062%2020%2078%2016%22%20fill%3D%22none%22%20stroke%3D%22%23e8c987%22%20stroke-width%3D%224%22%20stroke-linecap%3D%22round%22%2F%3E%3Ccircle%20cx%3D%2279%22%20cy%3D%2215%22%20r%3D%224.6%22%20fill%3D%22%23f6e6b8%22%2F%3E%3C%2Fsvg%3E');
  filter: drop-shadow(0 0 10rpx rgba(216, 168, 106, 0.65));
  animation: dfDragon 1.3s ease-out infinite;
}
@keyframes dfDragon {
  0% { transform: scale(0.55) rotate(-10deg); opacity: 0.35; }
  45% { opacity: 1; }
  100% { transform: scale(1.08) rotate(5deg); opacity: 0.92; }
}
/* 龙鳞：六瓣鎏金，环绕放射依次弹出 */
.df-scales .df-scale {
  position: absolute; width: 32rpx; height: 36rpx;
  clip-path: polygon(50% 0, 100% 26%, 100% 66%, 50% 100%, 0 66%, 0 26%);
  background: var(--grad-gold); opacity: 0;
  box-shadow: 0 0 12rpx rgba(216, 168, 106, 0.55);
}
.df-scale.s1 { top: 6rpx; left: 50%; margin-left: -16rpx; animation: dfScale 1.3s ease-out infinite; }
.df-scale.s2 { top: 30rpx; right: 26rpx; animation: dfScale 1.3s ease-out 0.12s infinite; }
.df-scale.s3 { bottom: 30rpx; right: 26rpx; animation: dfScale 1.3s ease-out 0.24s infinite; }
.df-scale.s4 { bottom: 6rpx; left: 50%; margin-left: -16rpx; animation: dfScale 1.3s ease-out 0.36s infinite; }
.df-scale.s5 { bottom: 30rpx; left: 26rpx; animation: dfScale 1.3s ease-out 0.48s infinite; }
.df-scale.s6 { top: 30rpx; left: 26rpx; animation: dfScale 1.3s ease-out 0.6s infinite; }
@keyframes dfScale {
  0% { opacity: 0; transform: scale(0.2) translateY(0); }
  35% { opacity: 1; }
  100% { opacity: 0; transform: scale(1) translateY(-14rpx); }
}

.reticle-hint {
  position: absolute; left: 50%; bottom: -92rpx; transform: translateX(-50%);
  display: flex; align-items: center; white-space: nowrap;
  background: rgba(20, 16, 12, 0.5); padding: 12rpx 24rpx; border-radius: 40rpx;
}
.reticle-hint text { font-size: 24rpx; color: rgba(255, 240, 215, 0.92); }
.reticle-pulse {
  width: 14rpx; height: 14rpx; border-radius: 50%; background: #e0b074; margin-right: 14rpx;
  animation: pulse 1.3s ease-in-out infinite;
}
@keyframes pulse { 0%, 100% { opacity: 0.4; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.2); } }

/* 云阙讲解面板 */
.brief {
  position: absolute; inset: 0; height: 100%;
  background: linear-gradient(180deg, #fbf6ec, #f4ebd9);
  border-radius: 0;
  transform: translateY(100%); transition: transform 0.5s cubic-bezier(0.22, 0.9, 0.28, 1);
  display: flex; flex-direction: column; overflow: hidden;
}
.brief.show { transform: translateY(0); }
.brief-top { flex-shrink: 0; padding: calc(env(safe-area-inset-top) + 86rpx) 34rpx 0; box-sizing: border-box; }
.brief-scroll { flex: 1; min-height: 0; padding: 26rpx 34rpx 20rpx; box-sizing: border-box; }

.yq-head { display: flex; align-items: center; }
.yq-avatar {
  width: 92rpx; height: 92rpx; border-radius: 50%; border: 3rpx solid #d8b884;
  box-shadow: 0 4rpx 14rpx rgba(150, 110, 60, 0.25);
}
.yq-meta { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.yq-name { font-size: 34rpx; font-weight: 700; color: #5a4632; }
.yq-role { font-size: 22rpx; color: #9a8670; margin-top: 4rpx; }
.yq-badge {
  background: linear-gradient(135deg, #c2a668, #a8893a); color: #fff;
  font-size: 22rpx; font-weight: 700; padding: 6rpx 16rpx; border-radius: 20rpx;
}

.restore-box {
  position: relative; margin-top: 22rpx; border-radius: 20rpx; overflow: hidden;
  height: 340rpx; box-shadow: 0 10rpx 26rpx rgba(120, 90, 50, 0.22);
}
.restore-video { width: 100%; height: 100%; visibility: hidden; background: transparent; }
.restore-video.is-playing { visibility: visible; }
.restore-fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  animation: restoreKen 20s ease-in-out infinite alternate;
}
@keyframes restoreKen {
  from { transform: scale(1.03); }
  to { transform: scale(1.14); }
}
.restore-chip {
  position: absolute; left: 16rpx; bottom: 16rpx; display: flex; align-items: center;
  background: rgba(30, 22, 14, 0.55); padding: 8rpx 18rpx; border-radius: 30rpx;
}
.restore-chip text { font-size: 20rpx; color: #f6e6c8; }
.restore-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #e6b878; margin-right: 12rpx; animation: pulse 1.2s infinite; }

/* 文物配图 */
.relic-box {
  position: relative; margin-top: 22rpx; border-radius: 20rpx; overflow: hidden;
  height: 420rpx; box-shadow: 0 10rpx 26rpx rgba(120, 90, 50, 0.22);
  background: #ece2cf;
}
.relic-img { width: 100%; height: 100%; }
.relic-chip {
  position: absolute; left: 16rpx; bottom: 16rpx; display: flex; align-items: center;
  background: rgba(30, 22, 14, 0.55); padding: 8rpx 18rpx; border-radius: 30rpx;
}
.relic-chip text { font-size: 20rpx; color: #f6e6c8; }
.relic-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d9a86a; margin-right: 12rpx; }

/* 滚动区：目标标签行 */
.target-tag {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 4rpx;
}
.target-kind-label {
  font-size: 22rpx; color: #a8893a; font-weight: 700; letter-spacing: 2rpx;
  background: rgba(200, 166, 104, 0.14); padding: 6rpx 18rpx; border-radius: 24rpx;
}
.target-seq { font-size: 22rpx; color: #a99a84; }

.lines {
  margin-top: 18rpx; background: #f1e7d4; border: 1rpx solid #e3d6bd;
  border-radius: 18rpx; padding: 22rpx 24rpx;
}
.line { border-left: 5rpx solid #c2a668; padding-left: 18rpx; margin-bottom: 14rpx; }
.line:last-child { margin-bottom: 0; }
.line-text { font-size: 27rpx; line-height: 1.65; color: #5f4d3a; }

.intro-card { margin-top: 26rpx; }
.block-title {
  display: block; font-size: 28rpx; font-weight: 700; color: #7a5a38;
  margin-bottom: 10rpx; position: relative; padding-left: 20rpx;
}
.block-title::before {
  content: ''; position: absolute; left: 0; top: 6rpx; bottom: 6rpx;
  width: 7rpx; border-radius: 4rpx; background: linear-gradient(180deg, #c2a668, #a8893a);
}
.intro-text { font-size: 26rpx; line-height: 1.7; color: #6f5f4d; }

/* 文物合规标注 */
.cultural-note {
  margin-top: 18rpx; background: #f3ede2; border-radius: 12rpx; padding: 14rpx 20rpx;
}
.cultural-note text { font-size: 21rpx; line-height: 1.55; color: #9a8c78; }

/* 商城导流卡片 */
.mall-entry {
  margin-top: 20rpx; display: flex; align-items: center;
  background: linear-gradient(135deg, #f7ecd4, #efdfba);
  border: 1rpx solid #d9bd85; border-radius: 18rpx; padding: 22rpx 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(160, 130, 70, 0.16);
}
.mall-entry-left { flex: 1; display: flex; flex-direction: column; }
.mall-entry-title { font-size: 27rpx; font-weight: 700; color: #8a5f2e; }
.mall-entry-sub { font-size: 22rpx; color: #a08a68; margin-top: 6rpx; }
.mall-entry-arrow { font-size: 40rpx; color: #b08a4a; margin-left: 12rpx; }

.source-toggle {
  margin-top: 24rpx; display: flex; justify-content: space-between; align-items: center;
  background: #f1e7d4; border: 1rpx dashed #c9b489; border-radius: 14rpx; padding: 18rpx 24rpx;
}
.source-toggle-label { font-size: 26rpx; color: #7a5a38; }
.source-arrow { font-size: 24rpx; color: #a8893a; }
.source-card {
  margin-top: 14rpx; background: #fbf4e6; border: 1rpx solid #e3d6bd;
  border-radius: 16rpx; padding: 22rpx 24rpx;
}
.sc-title { font-size: 26rpx; font-weight: 700; color: #7a5a38; }
.sc-work { margin-top: 12rpx; }
.sc-work-name { font-size: 24rpx; font-weight: 600; color: #8a6a44; }
.sc-quote {
  display: block; font-size: 24rpx; line-height: 1.6; color: #7a6c5a;
  margin-top: 4rpx; border-left: 4rpx solid #cdb88f; padding-left: 14rpx;
}
.sc-note { display: block; margin-top: 14rpx; font-size: 22rpx; line-height: 1.6; color: #93867a; }

/* 面板底部操作 */
.brief-actions {
  display: flex; gap: 16rpx; padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 20rpx);
  border-top: 1rpx solid #e3d6bd; background: #f8f1e2;
}
.brief-actions button {
  margin: 0; font-size: 26rpx; border-radius: 40rpx; line-height: 1;
  padding: 20rpx 0; flex: 1; display: flex; align-items: center; justify-content: center;
}
.act-ghost { background: transparent; border: 1rpx solid #c9b896; color: #7a6a52; flex: 0 0 128rpx !important; }
.act-collect { background: #fff; border: 1rpx solid #c9a86a; color: #9a6a32; }
.act-collect.done { background: #eef2e8; border-color: #a6bfae; color: #5f7a5a; }
.act-primary {
  background: linear-gradient(135deg, #c9a45f, #a8893a); color: #fff;
  border: 1rpx solid #a8893a; flex: 1.25;
}
.brief-actions button::after { border: none; }

/* 扫描底部 */
.cam-bottom {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 24rpx 40rpx calc(env(safe-area-inset-bottom) + 32rpx);
  background: linear-gradient(0deg, rgba(15, 12, 9, 0.62), transparent);
  display: flex; flex-direction: column; align-items: center;
}
.cam-status { font-size: 23rpx; color: rgba(255, 240, 215, 0.85); margin-bottom: 18rpx; text-align: center; }
.detect-btn { width: 82%; }
.btn-primary {
  background: linear-gradient(135deg, #c9a45f, #a8893a); color: #fff;
  font-size: 29rpx; font-weight: 600; border-radius: 44rpx; padding: 20rpx 0;
  line-height: 1.4; box-shadow: 0 8rpx 22rpx rgba(168, 137, 58, 0.4);
}
.btn-primary::after { border: none; }
