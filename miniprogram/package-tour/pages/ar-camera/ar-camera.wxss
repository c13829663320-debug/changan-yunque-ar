/* 现场 AR 相机页 · 页面级样式（组件内部样式见 ar-components/*） */
.ar-cam { position: relative; width: 100%; height: 100vh; overflow: hidden; background: #2c2722; }

/* ===== 启动遮罩（未就绪，用主题底色而非黑屏） ===== */
.boot-mask {
  position: absolute; inset: 0; z-index: 40;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(180deg, #3a3128 0%, #4a3d2f 60%, #5a4636 100%);
  padding: 60rpx;
}
.boot-card {
  width: 100%; background: rgba(251, 246, 236, 0.06);
  border: 1rpx solid rgba(194, 166, 104, 0.35);
  border-radius: var(--radius-lg);
  padding: 56rpx 40rpx; text-align: center;
  display: flex; flex-direction: column; align-items: center;
}
.boot-spinner {
  width: 64rpx; height: 64rpx; margin-bottom: 32rpx;
  border: 6rpx solid rgba(194, 166, 104, 0.25);
  border-top-color: var(--dark-gold-soft);
  border-radius: 50%;
  animation: ar-spin 0.9s linear infinite;
}
@keyframes ar-spin { to { transform: rotate(360deg); } }
.boot-title { font-size: var(--fs-h2); color: #f4ecdd; font-weight: 600; }
.boot-text {
  margin-top: 18rpx; font-size: var(--fs-small);
  color: rgba(244, 236, 221, 0.78); line-height: 1.6;
}

/* ===== 顶部标题 ===== */
.cam-top {
  position: absolute; top: calc(24rpx + env(safe-area-inset-top));
  left: 30rpx; right: 30rpx; z-index: 20;
  pointer-events: none;
}
.cam-title {
  display: block; text-align: center;
  font-size: var(--fs-body); font-weight: 600; color: #fbf3e4;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
}

/* ===== 状态胶囊 ===== */
.status-pill {
  position: absolute; top: calc(84rpx + env(safe-area-inset-top));
  left: 40rpx; right: 40rpx; z-index: 20;
  display: flex; justify-content: center;
  pointer-events: none;
}
.status-text {
  max-width: 100%;
  font-size: var(--fs-mini); color: #fbf3e4;
  background: rgba(70, 62, 54, 0.62);
  border: 1rpx solid rgba(194, 166, 104, 0.3);
  border-radius: 999rpx; padding: 8rpx 24rpx;
  line-height: 1.5; text-align: center;
}
