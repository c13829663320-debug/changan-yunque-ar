<view class="ar-cam">
  <!-- ===== marker 识别层（VKSession，自带相机画布） ===== -->
  <marker-layer
    wx:if="{{bootState === 'ready' && mode === 'marker'}}"
    scene="{{scene}}"
    active="{{true}}"
    enable-glb="{{enableGlb}}"
    marker-path="{{markerPath}}"
    reload-key="{{reloadKey}}"
    bind:status="onLayerStatus"
    bind:detected="onDetected"
    bind:lost="onLost"
    bind:fallback="onLayerFallback"
  ></marker-layer>

  <!-- ===== LBS 方位 / 静态兜底层（自带相机或主题背景） ===== -->
  <lbs-layer
    wx:if="{{bootState === 'ready' && (mode === 'lbs' || mode === 'static')}}"
    scene="{{scene}}"
    active="{{true}}"
    mode="{{mode}}"
    location-granted="{{locationGranted}}"
    reload-key="{{reloadKey}}"
    bind:status="onLayerStatus"
    bind:arrive="onArrive"
    bind:heading="noop"
    bind:permission="onRequestPermission"
    bind:fallback="onLayerFallback"
  ></lbs-layer>

  <!-- ===== 启动中遮罩（不渲染相机，避免未授权先黑屏） ===== -->
  <view class="boot-mask" wx:if="{{bootState !== 'ready'}}">
    <view class="boot-card">
      <view class="boot-spinner"></view>
      <text class="boot-title">现场AR · {{sceneName}}</text>
      <text class="boot-text">{{statusText}}</text>
    </view>
  </view>

  <!-- ===== 顶部标题（就绪后悬浮，不阻挡操作） ===== -->
  <view class="cam-top" wx:if="{{bootState === 'ready'}}">
    <text class="cam-title">现场AR · {{sceneName}}</text>
  </view>

  <!-- ===== 顶部状态条 ===== -->
  <view class="status-pill" wx:if="{{bootState === 'ready'}}">
    <text class="status-text">{{statusText}}</text>
  </view>
</view>
