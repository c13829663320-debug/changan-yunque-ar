<view class="ar-cam">
  <camera wx:if="{{phase !== 'briefing'}}" class="cam" device-position="back" flash="off" binderror="onCamError"></camera>

  <!-- 左上角：退出到首页 -->
  <view class="exit-btn {{phase === 'briefing' ? 'on-light' : ''}}" bindtap="onExit">
    <text class="exit-glyph">✕</text>
    <text class="exit-label">退出</text>
  </view>

  <!-- 顶部标题（扫描 / 识别时） -->
  <view class="cam-top" wx:if="{{phase !== 'briefing'}}">
    <text class="cam-kicker">现场 AR · 云阙识别</text>
    <text class="cam-title">{{targetName}}</text>
    <text wx:if="{{targetKind === 'relic' && era}}" class="cam-era">{{era}}</text>
  </view>

  <!-- 扫描 / 识别取景框 -->
  <view class="reticle {{phase === 'recognizing' ? 'busy' : ''}}" wx:if="{{phase !== 'briefing'}}">
    <view class="reticle-corner tl"></view>
    <view class="reticle-corner tr"></view>
    <view class="reticle-corner bl"></view>
    <view class="reticle-corner br"></view>
    <view class="scan-line" wx:if="{{phase === 'scanning'}}"></view>
    <view class="reticle-spin" wx:if="{{phase === 'recognizing'}}"></view>
    <view class="reticle-hint">
      <view class="reticle-pulse"></view>
      <text>{{phase === 'recognizing' ? '正在识别图像特征…' : '对准景点 / 物品'}}</text>
    </view>
  </view>

  <!-- 云阙 AR 讲解（全屏，camera 已隐藏以保证视频正常播放） -->
  <view class="brief {{phase === 'briefing' ? 'show' : ''}}" wx:if="{{phase === 'briefing'}}">
    <view class="brief-top">
      <view class="yq-head">
        <image class="yq-avatar" src="/assets/characters/yunque-avatar.jpg" mode="aspectFill"></image>
        <view class="yq-meta">
          <text class="yq-name">云阙</text>
          <text class="yq-role">{{targetKind === 'relic' ? '盛唐走龙 · 为你讲文物' : '盛唐走龙 · 为你讲解'}}</text>
        </view>
        <view class="yq-badge">{{targetKind === 'relic' ? '文物' : 'AR'}}</view>
      </view>

      <!-- 景点：动态复原视频 -->
      <view class="restore-box" wx:if="{{targetKind === 'spot'}}">
        <video
          id="briefVideo"
          class="restore-video"
          src="{{restoreVideo}}"
          poster="{{poster}}"
          autoplay
          loop
          muted
          controls="{{false}}"
          show-center-play-btn="{{false}}"
          show-play-btn="{{false}}"
          show-fullscreen-btn="{{false}}"
          enable-progress-gesture="{{false}}"
          object-fit="cover"
        ></video>
        <view class="restore-chip"><text class="restore-dot"></text><text>AR 动态复原</text></view>
      </view>

      <!-- 文物：文物配图 -->
      <view class="relic-box" wx:if="{{targetKind === 'relic'}}">
        <image class="relic-img" src="{{relicImage}}" mode="aspectFill"></image>
        <view class="relic-chip"><text class="relic-dot"></text><text>{{era}}</text></view>
      </view>
    </view>

    <scroll-view scroll-y class="brief-scroll" enhanced show-scrollbar="{{false}}">
      <view class="target-tag">
        <text class="target-kind-label">{{targetKind === 'relic' ? '可扫描文物' : '长安点位'}}</text>
        <text class="target-seq">{{seqIndex + 1}} / {{seqTotal}}</text>
      </view>

      <view class="lines">
        <view class="line" wx:for="{{yunqueLines}}" wx:key="text">
          <text class="line-text">{{item.text}}</text>
        </view>
      </view>

      <view class="intro-card">
        <text class="block-title">{{targetKind === 'relic' ? '文物档案' : '历史背景'}}</text>
        <text class="intro-text">{{intro}}</text>
      </view>

      <view wx:if="{{culturalNote}}" class="cultural-note">
        <text>{{culturalNote}}</text>
      </view>

      <!-- 文物 → 商城导流 -->
      <view wx:if="{{targetKind === 'relic' && goodsId}}" class="mall-entry" bindtap="onViewGoods">
        <view class="mall-entry-left">
          <text class="mall-entry-title">把这件「长安」带回家</text>
          <text class="mall-entry-sub">商城查看典藏复刻 · 附收藏证书</text>
        </view>
        <text class="mall-entry-arrow">›</text>
      </view>

      <view class="source-toggle" bindtap="onToggleSource">
        <text class="source-toggle-label">可溯源史料卡</text>
        <text class="source-arrow">{{showSource ? '收起' : '展开'}} ›</text>
      </view>
      <view class="source-card" wx:if="{{showSource}}">
        <text class="sc-title">{{sourceCard.title}}</text>
        <view class="sc-work" wx:for="{{sourceCard.works}}" wx:key="name">
          <text class="sc-work-name">《{{item.name}}》</text>
          <text wx:if="{{item.quote}}" class="sc-quote">{{item.quote}}</text>
        </view>
        <text class="sc-note">{{sourceCard.note}}</text>
      </view>
    </scroll-view>

    <view class="brief-actions">
      <button class="act-ghost" bindtap="onRescan">重扫</button>
      <button
        wx:if="{{targetKind === 'spot'}}"
        class="act-collect {{collected ? 'done' : ''}}"
        bindtap="onCollect"
      >{{collected ? '已集龙鳞' : '收集「' + scaleName + '」'}}</button>
      <button
        wx:if="{{targetKind === 'relic'}}"
        class="act-collect {{relicInAlbum ? 'done' : ''}}"
        bindtap="onCollect"
      >{{relicInAlbum ? '已入图鉴' : '收入图鉴'}}</button>
      <button class="act-primary" bindtap="onNext">下一目标 ›</button>
    </view>
  </view>

  <!-- 扫描底部 -->
  <view class="cam-bottom" wx:if="{{phase !== 'briefing'}}">
    <text class="cam-status">{{statusText}}</text>
    <button class="btn-primary detect-btn" bindtap="onManualDetect">
      {{phase === 'recognizing' ? '识别中…' : '对准后识别'}}
    </button>
  </view>
</view>
