<view class="ar-cam">
  <camera class="cam" device-position="back" flash="off" binderror="onCamError"></camera>

  <!-- 顶部：现场 AR 标题 -->
  <view class="cam-top">
    <text class="cam-kicker">现场 AR · 云阙识别</text>
    <text class="cam-title">{{sceneName}}</text>
  </view>

  <!-- 扫描 / 识别取景框 -->
  <view class="reticle {{phase === 'recognizing' ? 'busy' : ''}}" wx:if="{{phase !== 'briefing'}}">
    <view class="reticle-corner tl"></view>
    <view class="reticle-corner tr"></view>
    <view class="reticle-corner bl"></view>
    <view class="reticle-corner br"></view>
    <view class="scan-line" wx:if="{{phase === 'scanning'}}"></view>
    <view class="reticle-spin" wx:if="{{phase === 'recognizing'}}"></view>
    <view class="reticle-hint">
      <view class="reticle-pulse"></view>
      <text>{{phase === 'recognizing' ? '正在识别图像特征…' : '对准景点 / 物品'}}</text>
    </view>
  </view>

  <!-- 云阙 AR 讲解弹层 -->
  <view class="brief {{phase === 'briefing' ? 'show' : ''}}" wx:if="{{phase === 'briefing'}}">
    <!-- 顶部固定：云阙 + AR复原视频（原生 video 不放进 scroll-view，避免黑屏） -->
    <view class="brief-top">
      <view class="yq-head">
        <image class="yq-avatar" src="/assets/characters/yunque-avatar.jpg" mode="aspectFill"></image>
        <view class="yq-meta">
          <text class="yq-name">云阙</text>
          <text class="yq-role">盛唐走龙 · 为你讲解</text>
        </view>
        <view class="yq-badge">AR</view>
      </view>

      <view class="restore-box">
        <video
          id="briefVideo"
          class="restore-video"
          src="{{restoreVideo}}"
          poster="{{poster}}"
          autoplay
          loop
          muted
          controls="{{false}}"
          show-center-play-btn="{{false}}"
          show-play-btn="{{false}}"
          show-fullscreen-btn="{{false}}"
          enable-progress-gesture="{{false}}"
          object-fit="cover"
        ></video>
        <view class="restore-chip"><text class="restore-dot"></text><text>AR 动态复原</text></view>
      </view>
    </view>

    <!-- 可滚动：讲解词 / 历史背景 / 史料卡 -->
    <scroll-view scroll-y class="brief-scroll" enhanced show-scrollbar="{{false}}">
      <view class="lines">
        <view class="line" wx:for="{{yunqueLines}}" wx:key="text">
          <text class="line-text">{{item.text}}</text>
        </view>
      </view>

      <view class="intro-card">
        <text class="block-title">历史背景</text>
        <text class="intro-text">{{intro}}</text>
      </view>

      <view class="source-toggle" bindtap="onToggleSource">
        <text class="source-toggle-label">可溯源史料卡</text>
        <text class="source-arrow">{{showSource ? '收起' : '展开'}} ›</text>
      </view>
      <view class="source-card" wx:if="{{showSource}}">
        <text class="sc-title">{{sourceCard.title}}</text>
        <view class="sc-work" wx:for="{{sourceCard.works}}" wx:key="name">
          <text class="sc-work-name">《{{item.name}}》</text>
          <text wx:if="{{item.quote}}" class="sc-quote">{{item.quote}}</text>
        </view>
        <text class="sc-note">{{sourceCard.note}}</text>
      </view>
    </scroll-view>

    <!-- 底部操作 -->
    <view class="brief-actions">
      <button class="act-ghost" bindtap="onRescan">重扫</button>
      <button class="act-collect {{collected ? 'done' : ''}}" bindtap="onCollect">
        {{collected ? '已集龙鳞' : '收集「' + scaleName + '」'}}
      </button>
      <button class="act-primary" bindtap="onNext">下一景点 ›</button>
    </view>
  </view>

  <!-- 扫描底部 -->
  <view class="cam-bottom" wx:if="{{phase !== 'briefing'}}">
    <text class="cam-status">{{statusText}}</text>
    <button class="btn-primary detect-btn" bindtap="onManualDetect">
      {{phase === 'recognizing' ? '识别中…' : '对准后识别'}}
    </button>
  </view>
</view>
