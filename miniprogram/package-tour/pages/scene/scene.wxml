<view class="scene scene-tone-{{scene.index}}">
  <!-- 舞台 -->
  <view class="stage {{stageBg ? 'has-bg' : ''}}" style="{{stageBg ? 'background-image:url(' + stageBg + ')' : ''}}">
    <view class="stage-scrim"></view>
    <view class="figure-wrap {{node.actor}}">
      <view class="figure {{node.actor === 'yunque' ? 'figure-yunque' : ''}}">
        <image wx:if="{{node.actor === 'yunque'}}" class="figure-img" src="{{figureSrc}}" mode="aspectFill" />
        <text wx:else class="figure-word">{{figureLabel}}</text>
      </view>
      <view class="figure-shadow"></view>
    </view>
    <text class="place-tag">{{scene.name}} · {{scene.role}}</text>
  </view>

  <!-- AR 复原层 -->
  <view class="ar-mask" wx:if="{{showAR}}" bindtap="closeAR">
    <view class="ar-frame" catchtap="noop">
      <image wx:if="{{scene.arRestoreImage}}" class="ar-restore" src="{{scene.arRestoreImage}}" mode="widthFix" />
      <view wx:else class="ar-palace">
        <view class="ar-roof"></view>
        <view class="ar-body"></view>
        <view class="ar-base"></view>
      </view>
      <text class="ar-title">AR 复原 · {{scene.name}}</text>
      <text class="ar-tip">{{arTip}}</text>
      <button
        class="btn-primary ar-continue"
        catchtap="closeAR"
        disabled="{{!arCanClose}}"
      >{{arCanClose ? '继续剧情' : '复原展开中（' + arCountdown + '）'}}</button>
    </view>
  </view>

  <!-- 史料卡 -->
  <view class="source-mask" wx:if="{{showSource}}" bindtap="closeSource">
    <view class="source-panel" catchtap="noop">
      <text class="s-title">{{scene.sourceCard.title}}</text>
      <view class="s-work" wx:for="{{scene.sourceCard.works}}" wx:key="name">
        <text class="work-name">{{item.name}}</text>
        <text class="work-quote" wx:if="{{item.quote}}">「{{item.quote}}」</text>
      </view>
      <text class="s-note">{{scene.sourceCard.note}}</text>
      <button class="btn-ghost s-close" catchtap="closeSource">我知道了</button>
    </view>
  </view>

  <!-- 分支反馈 -->
  <view class="feedback-bar {{feedbackCorrect ? 'fb-right' : 'fb-wrong'}}" wx:if="{{showFeedback}}">
    <text class="fb-name">{{feedback.actorName || ''}}</text>
    <text class="fb-text">{{feedback.text}}</text>
    <view class="fb-easter" wx:if="{{feedbackCorrect && feedbackEasterEgg}}">
      <text class="fb-easter-tag">合礼 · 彩蛋</text>
      <text class="fb-easter-text">{{feedbackEasterEgg}}</text>
    </view>
    <button class="btn-primary fb-continue" bindtap="dismissFeedback">继续</button>
  </view>

  <!-- 结算 -->
  <view class="end-mask" wx:if="{{finished}}">
    <view class="end-panel">
      <view class="scale-circle"><text class="scale-word">{{scene.scaleName}}</text></view>
      <text class="end-title">你获得一片龙鳞</text>
      <text class="end-sub">龙鳞 {{scaleCount}} / {{total}}</text>
      <button class="btn-primary" bindtap="goNext" wx:if="{{hasNext}}">前往下一点位</button>
      <!-- 终章（玄武门）结算后：生成祈愿分享卡入口，仅对 xuanwumen 生效 -->
      <button
        class="btn-primary end-share"
        wx:if="{{!hasNext && scene.id === 'xuanwumen'}}"
        bindtap="openShareCard"
      >生成祈愿分享卡</button>
      <button class="btn-ghost end-back" bindtap="backMap">返回巡游地图</button>
    </view>
  </view>

  <!-- 祈愿分享卡（终章专属，Canvas 2D） -->
  <share-card
    visible="{{showShareCard}}"
    wish="{{wishText}}"
    scale-count="{{scaleCount}}"
    scale-name="{{scene.scaleName}}"
    bind:ready="onShareCardReady"
    bind:close="onShareCardClose"
  ></share-card>

  <!-- 现场定位拦截 -->
  <view class="geo-mask" wx:if="{{geoBlock}}">
    <view class="geo-panel">
      <text class="geo-title">{{geoBlockReason === 'range' ? '尚在远处' : '暂时没能定位'}}</text>
      <block wx:if="{{geoBlockReason === 'range'}}">
        <text class="geo-text">到达『{{scene.name}}』附近后自动解锁</text>
        <text class="geo-dist">距此约 {{geoDistance}} 米</text>
      </block>
      <block wx:else>
        <text class="geo-text">暂时没能定位到你，可以先云游体验，或在到现场后重新检测定位。</text>
      </block>
      <button class="btn-primary" bindtap="retryLocation">重新检测定位</button>
      <button class="btn-ghost" bindtap="goCloud">先云游体验</button>
    </view>
  </view>

  <!-- 对话区 -->
  <view class="dialog-bar" wx:if="{{entered && !finished && !showFeedback}}">
    <view class="actor-line">
      <text class="a-name">{{actorDisplay}}</text>
      <view class="source-mini" bindtap="openSource">史料卡</view>
    </view>
    <text class="d-text">{{node.text}}</text>
    <view class="choices" wx:if="{{showChoices}}">
      <button
        class="choice-btn"
        wx:for="{{node.choices}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onChoose"
      >{{item.text}}</button>
    </view>
    <button class="btn-primary next-btn" wx:else bindtap="onNext">{{nextLabel}}</button>
  </view>
</view>
