.scene {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #e9e0cd 0%, #f1e9d8 55%, #f6efe2 100%);
}
/* 各点位色调微调 */
.scene-tone-2 { background: linear-gradient(180deg, #e3e6e2 0%, #efe8d8 60%, #f6efe2 100%); }
.scene-tone-6 { background: linear-gradient(180deg, #e7ded0 0%, #f0e6d4 60%, #f6efe2 100%); }
.scene-tone-7 { background: linear-gradient(180deg, #e2e4e3 0%, #ede5d5 60%, #f6efe2 100%); }

/* 舞台 */
.stage { flex: 1; position: relative; display: flex; align-items: center; justify-content: center; min-height: 60vh; overflow: hidden; }
.stage-video { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
.figure-wrap { position: relative; display: flex; flex-direction: column; align-items: center; }
.figure {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #fbf6ec, #e2d4bb);
  border: 2rpx solid var(--dark-gold-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: float 3.6s ease-in-out infinite;
}
.figure-word { color: var(--dark-gold); font-size: 40rpx; letter-spacing: 4rpx; }
.figure-wrap.liguan .figure { border-color: var(--azurite-deep); }
.figure-wrap.liguan .figure-word { color: var(--azurite-deep); }
.figure-wrap.narrator .figure { opacity: 0.5; width: 120rpx; height: 120rpx; }
.figure-wrap.narrator .figure-word { font-size: 28rpx; color: var(--ink-muted); }
.figure-shadow { width: 160rpx; height: 24rpx; border-radius: 50%; background: rgba(90,74,50,0.12); margin-top: 18rpx; filter: blur(6rpx); }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14rpx); } }
.place-tag { position: absolute; top: 40rpx; font-size: var(--fs-mini); color: var(--ink-muted); letter-spacing: 2rpx; }

/* 对话区 */
.dialog-bar {
  background: var(--bg-card);
  border-top: 1rpx solid var(--line);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(90,74,50,0.08);
  padding: 26rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
}
.actor-line { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.a-name { font-size: var(--fs-small); color: var(--cinnabar); font-weight: 600; }
.source-mini { font-size: var(--fs-mini); color: var(--dark-gold); border: 1rpx solid var(--dark-gold-soft); border-radius: 999rpx; padding: 4rpx 18rpx; }
.d-text { font-size: var(--fs-body); color: var(--ink-soft); line-height: 1.8; display: block; margin-bottom: 24rpx; }
.next-btn { margin-top: 4rpx; }
.choices { display: flex; flex-direction: column; gap: 16rpx; }
.choice-btn {
  background: var(--bg-card-deep);
  color: var(--ink-soft);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  font-size: var(--fs-body);
  height: 88rpx;
}
.choice-btn::after { border: none; }

/* 反馈 */
.feedback-bar {
  position: fixed;
  left: 30rpx; right: 30rpx; bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-deep);
  padding: 26rpx;
  z-index: 30;
}
.fb-name { font-size: var(--fs-small); color: var(--azurite-deep); font-weight: 600; }
.fb-text { font-size: var(--fs-body); color: var(--ink-soft); line-height: 1.7; display: block; margin: 12rpx 0 20rpx; }

/* AR */
.ar-mask, .source-mask, .end-mask {
  position: fixed; inset: 0; background: rgba(58,50,40,0.55);
  display: flex; align-items: center; justify-content: center; z-index: 40; padding: 40rpx;
}
.ar-frame {
  width: 100%;
  background: linear-gradient(180deg, #dfe7e4, #eef0ea);
  border-radius: var(--radius-lg);
  padding: 50rpx 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ar-palace { position: relative; height: 280rpx; width: 320rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; margin-bottom: 24rpx; }
.ar-roof {
  width: 300rpx; height: 70rpx;
  background: linear-gradient(180deg, #b08d68, #c7a987);
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}
.ar-body { width: 220rpx; height: 130rpx; background: repeating-linear-gradient(90deg,#d8c4a4 0 20rpx,#cdb690 20rpx 40rpx); border: 1rpx solid #b08d68; }
.ar-base { width: 300rpx; height: 24rpx; background: #b08d68; border-radius: 4rpx; }
.ar-title { font-size: var(--fs-h2); color: var(--ink); font-weight: 600; }
.ar-tip { font-size: var(--fs-small); color: var(--ink-muted); text-align: center; margin: 14rpx 0 26rpx; line-height: 1.6; }
.ar-continue { width: 100%; }

/* 史料卡 */
.source-panel { width: 100%; background: var(--bg-card); border-radius: var(--radius-lg); padding: 36rpx 30rpx 28rpx; max-height: 80vh; overflow-y: auto; }
.s-title { font-size: var(--fs-title); color: var(--ink); font-weight: 600; display: block; margin-bottom: 20rpx; }
.s-work { background: var(--bg-card-deep); border-radius: var(--radius); padding: 18rpx 20rpx; margin-bottom: 14rpx; }
.work-name { font-size: var(--fs-body); color: var(--dark-gold); }
.work-quote { font-size: var(--fs-small); color: var(--ink-soft); display: block; margin-top: 8rpx; line-height: 1.6; }
.s-note { font-size: var(--fs-small); color: var(--ink-muted); line-height: 1.7; display: block; margin: 16rpx 0 24rpx; }

/* 结算 */
.end-panel { width: 100%; background: var(--bg-card); border-radius: var(--radius-lg); padding: 44rpx 34rpx 30rpx; display: flex; flex-direction: column; align-items: center; }
.scale-circle { width: 180rpx; height: 180rpx; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fbf6ec, #e2d4bb); border: 2rpx solid var(--dark-gold); display: flex; align-items: center; justify-content: center; margin-bottom: 22rpx; }
.scale-word { color: var(--dark-gold); font-size: 34rpx; letter-spacing: 2rpx; }
.end-title { font-size: var(--fs-h2); color: var(--ink); font-weight: 600; }
.end-sub { font-size: var(--fs-small); color: var(--ink-muted); margin: 10rpx 0 28rpx; }
.end-back { width: 100%; margin-top: 16rpx; }
.end-share { width: 100%; margin-top: 16rpx; }

/* ===== 美术接线（数据驱动，见 docs/frontend-art-spec.md）===== */
/* 舞台背景 */
.stage.has-bg { background-size: cover; background-position: center; background-repeat: no-repeat; }
.stage-scrim {
  position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: linear-gradient(180deg, rgba(244,236,221,0.16) 0%, rgba(244,236,221,0.04) 42%, rgba(244,236,221,0.40) 100%);
}
.figure-wrap { z-index: 2; }
.place-tag { z-index: 2; text-shadow: 0 1rpx 6rpx rgba(244,236,221,0.7); }

/* 云阙「壁画龛」肖像（官方立绘，灰底以拱龛框收） */
.figure-yunque {
  width: 300rpx !important;
  height: 420rpx !important;
  border-radius: 150rpx 150rpx 26rpx 26rpx !important;
  overflow: hidden;
  padding: 0;
  background: linear-gradient(180deg, #d9d4cc, #c9c3b8);
  box-shadow: 0 14rpx 40rpx rgba(70, 62, 54, 0.22);
}
.figure-img { width: 100%; height: 100%; display: block; }
.figure-wrap.yunque .figure-shadow { width: 200rpx; margin-top: 22rpx; }

/* AR 复原图 */
.ar-restore {
  width: 100%; height: 500rpx; display: block;
  border-radius: var(--radius);
  border: 1rpx solid var(--line);
  margin-bottom: 24rpx;
  background: #14110d;
  box-shadow: 0 8rpx 24rpx rgba(70, 62, 54, 0.12);
}

/* ===== 配音控制 ===== */
.voice-controls { display: flex; align-items: center; gap: 12rpx; }
.vc-btn {
  font-size: var(--fs-mini); color: var(--dark-gold);
  border: 1rpx solid var(--dark-gold-soft); border-radius: 999rpx;
  padding: 4rpx 18rpx; line-height: 1.7; background: var(--bg-card);
}

/* ===== 集鳞仪式动画 ===== */
.scale-fx {
  position: fixed; inset: 0; z-index: 60;
  display: flex; align-items: center; justify-content: center;
  pointer-events: none;
  background: radial-gradient(circle at 50% 46%, rgba(198,160,86,0.20), rgba(40,32,20,0.55));
  animation: sfxFade 1.3s ease forwards;
}
@keyframes sfxFade {
  0% { opacity: 0; } 15% { opacity: 1; } 80% { opacity: 1; } 100% { opacity: 0; }
}
.scale-fx-glow {
  position: absolute; width: 360rpx; height: 360rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,224,150,0.85), rgba(214,170,90,0.25) 55%, transparent 72%);
  animation: sfxGlow 1.3s ease-out forwards;
}
@keyframes sfxGlow {
  0% { transform: scale(0.3); opacity: 0; }
  40% { opacity: 1; } 100% { transform: scale(1.5); opacity: 0.4; }
}
.scale-fx-rays {
  position: absolute; width: 520rpx; height: 520rpx; border-radius: 50%;
  background: conic-gradient(from 0deg,
    rgba(255,225,160,0) 0deg, rgba(255,225,160,0.55) 12deg, rgba(255,225,160,0) 24deg,
    rgba(255,225,160,0.45) 60deg, rgba(255,225,160,0) 72deg,
    rgba(255,225,160,0.5) 120deg, rgba(255,225,160,0) 132deg,
    rgba(255,225,160,0.4) 180deg, rgba(255,225,160,0) 192deg,
    rgba(255,225,160,0.5) 240deg, rgba(255,225,160,0) 252deg,
    rgba(255,225,160,0.45) 300deg, rgba(255,225,160,0) 312deg);
  animation: sfxSpin 1.3s ease-out forwards; opacity: 0.7;
}
@keyframes sfxSpin {
  0% { transform: rotate(0) scale(0.4); opacity: 0; }
  35% { opacity: 0.9; }
  100% { transform: rotate(120deg) scale(1.15); opacity: 0.2; }
}
.scale-fx-scale {
  position: relative; z-index: 2;
  width: 200rpx; height: 200rpx; border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, #fbe6ad, #d9a948 70%, #b6812c);
  border: 3rpx solid rgba(255,235,180,0.9);
  box-shadow: 0 0 60rpx rgba(255,210,120,0.9), inset 0 0 30rpx rgba(255,240,200,0.7);
  display: flex; align-items: center; justify-content: center;
  animation: sfxScale 1.3s cubic-bezier(0.2,1.3,0.4,1) forwards;
}
@keyframes sfxScale {
  0% { transform: scale(0) rotate(-120deg); opacity: 0; }
  55% { transform: scale(1.15) rotate(10deg); opacity: 1; }
  75% { transform: scale(1) rotate(0); }
  100% { transform: scale(1.05); opacity: 1; }
}
.sfx-word { color: #5b3f14; font-size: 32rpx; font-weight: 700; letter-spacing: 2rpx; }
.scale-fx-particles { position: absolute; inset: 0; }
.sfx-pt {
  position: absolute; left: 50%; top: 46%;
  width: 14rpx; height: 14rpx; margin: -7rpx 0 0 -7rpx;
  border-radius: 50%; background: #ffe6a8;
  box-shadow: 0 0 12rpx rgba(255,220,140,0.9);
  animation: sfxPt 1.3s ease-out forwards;
}
@keyframes sfxPt {
  0% { opacity: 0; transform: rotate(calc(var(--i) * 36deg)) translateY(20rpx) scale(0.5); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: rotate(calc(var(--i) * 36deg)) translateY(-260rpx) scale(1); }
}

/* ===== 复原视频兜底：彻底消除模拟器黑屏 ===== */
@keyframes kenburns {
  from { transform: scale(1.03); }
  to { transform: scale(1.15); }
}
/* 舞台兜底画面（video 未播放时显示，带缓慢电影运镜） */
.stage-fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  animation: kenburns 24s ease-in-out infinite alternate;
}
.stage-video { visibility: hidden; background: transparent; }
.stage-video.is-playing { visibility: visible; }

/* AR 复原容器与兜底画面 */
.ar-media {
  position: relative;
  width: 100%;
  height: 500rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius);
  overflow: hidden;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 24rpx rgba(70, 62, 54, 0.12);
}
.ar-fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  animation: kenburns 20s ease-in-out infinite alternate;
}
.ar-restore {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  visibility: hidden;
}
.ar-restore.is-playing { visibility: visible; }
