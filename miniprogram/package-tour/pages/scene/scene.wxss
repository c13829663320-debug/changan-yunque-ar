.scene {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #e9e0cd 0%, #f1e9d8 55%, #f6efe2 100%);
}
/* 各点位色调微调 */
.scene-tone-2 { background: linear-gradient(180deg, #e3e6e2 0%, #efe8d8 60%, #f6efe2 100%); }
.scene-tone-6 { background: linear-gradient(180deg, #e7ded0 0%, #f0e6d4 60%, #f6efe2 100%); }
.scene-tone-7 { background: linear-gradient(180deg, #e2e4e3 0%, #ede5d5 60%, #f6efe2 100%); }

/* 舞台 */
.stage { flex: 1; position: relative; display: flex; align-items: center; justify-content: center; min-height: 60vh; overflow: hidden; }
.stage-video { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
.place-tag { position: absolute; top: 40rpx; font-size: var(--fs-mini); color: var(--ink-muted); letter-spacing: 2rpx; }
.restore-tag {
  position: absolute; left: 24rpx; bottom: 22rpx; z-index: 2;
  font-size: 22rpx; color: var(--ink-muted); letter-spacing: 2rpx;
  background: rgba(244,236,221,0.66);
  border: 1rpx solid rgba(150,120,70,0.28);
  border-radius: 999rpx; padding: 5rpx 18rpx;
  text-shadow: 0 1rpx 4rpx rgba(244,236,221,0.6);
}

/* 对话区 */
.dialog-bar {
  background: var(--bg-card);
  border-top: 1rpx solid var(--line);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(90,74,50,0.08);
  padding: 26rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
}
.actor-line { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.a-name {
  font-size: var(--fs-small); color: var(--cinnabar); font-weight: 600;
  letter-spacing: 2rpx; padding-left: 16rpx; position: relative;
}
.a-name::before {
  content: ''; position: absolute; left: 0; top: 50%;
  width: 9rpx; height: 9rpx; transform: translateY(-50%) rotate(45deg);
  background: var(--grad-gold);
}
.d-text { font-size: var(--fs-body); color: var(--ink-soft); line-height: 1.85; display: block; margin-bottom: 24rpx; }
.next-btn { margin-top: 4rpx; }
.choices { display: flex; flex-direction: column; gap: 16rpx; }
.choice-btn {
  background: var(--bg-card-deep);
  color: var(--ink-soft);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  font-size: var(--fs-body);
  height: 88rpx;
  transition: transform 0.15s ease, background 0.2s ease;
}
.choice-btn::after { border: none; }
.choice-btn:active { transform: scale(0.98); background: #ecdfc4; }

/* 分支反馈 · 精致小卡 */
.feedback-bar {
  position: fixed;
  left: 30rpx; right: 30rpx; bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, var(--bg-card) 0%, #f6ecd8 100%);
  border: 1rpx solid var(--dark-gold-soft);
  border-left: 8rpx solid var(--cinnabar);
  border-radius: 20rpx;
  box-shadow: var(--shadow-deep);
  padding: 24rpx 26rpx;
  z-index: 30;
  animation: fbIn 0.3s ease both;
}
@keyframes fbIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: none; } }
.fb-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.fb-diamond { width: 11rpx; height: 11rpx; transform: rotate(45deg); background: var(--grad-gold); box-shadow: 0 0 6rpx rgba(168,137,58,0.5); }
.fb-name { font-size: var(--fs-small); color: var(--cinnabar); font-weight: 600; letter-spacing: 1rpx; }
.fb-text { font-size: var(--fs-body); color: var(--ink-soft); line-height: 1.75; display: block; margin: 0 0 20rpx; }
.fb-continue { width: 100%; }

/* 通用弹层遮罩 */
.ar-mask, .source-mask, .end-mask {
  position: fixed; inset: 0; background: rgba(58,50,40,0.55);
  display: flex; align-items: center; justify-content: center; z-index: 40; padding: 40rpx;
}

/* AR 复原 · 鎏金画框/壁龛 */
.ar-frame {
  width: 100%;
  background: linear-gradient(150deg, #e9d39a 0%, #b8944a 30%, #8a6c2a 55%, #c9a85e 80%, #e7cf94 100%);
  padding: 8rpx;
  border-radius: 26rpx;
  box-shadow: 0 24rpx 60rpx rgba(28,20,10,0.5);
}
.ar-inner {
  position: relative;
  background: linear-gradient(180deg, #2b2214 0%, #3a2d1a 100%);
  border-radius: 18rpx;
  padding: 46rpx 28rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}
.ar-corner {
  position: absolute; width: 54rpx; height: 54rpx;
  background-size: contain; background-repeat: no-repeat; background-position: center;
  background-image: url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http://www.w3.org/2000/svg%22%20viewBox%3D%220%200%2048%2048%22%3E%3Cpath%20d%3D%22M6%2020V6H20%22%20stroke%3D%22%23d8bd7e%22%20stroke-width%3D%222.5%22%20fill%3D%22none%22%20stroke-linecap%3D%22round%22%2F%3E%3Ccircle%20cx%3D%2211%22%20cy%3D%2211%22%20r%3D%223%22%20fill%3D%22%23eedca6%22%22%2F%3E%3C%2Fsvg%3E');
}
.ar-corner-tl { top: 14rpx; left: 14rpx; }
.ar-corner-tr { top: 14rpx; right: 14rpx; transform: rotate(90deg); }
.ar-corner-br { bottom: 14rpx; right: 14rpx; transform: rotate(180deg); }
.ar-corner-bl { bottom: 14rpx; left: 14rpx; transform: rotate(270deg); }
.ar-plaque {
  background: linear-gradient(150deg, #e7cf94, #a8893a);
  padding: 10rpx 42rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.35), inset 0 1rpx 2rpx rgba(255,248,224,0.6);
  margin-bottom: 24rpx;
}
.ar-title { font-size: var(--fs-h2); color: #3a2a0e; font-weight: 600; letter-spacing: 3rpx; }
.ar-palace { position: relative; height: 280rpx; width: 320rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; margin-bottom: 8rpx; }
.ar-roof {
  width: 300rpx; height: 70rpx;
  background: linear-gradient(180deg, #d8bd7e, #8a6c2a);
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}
.ar-body { width: 220rpx; height: 130rpx; background: repeating-linear-gradient(90deg,#4a3a22 0 20rpx,#372b18 20rpx 40rpx); border: 1rpx solid #c9a85e; }
.ar-base { width: 300rpx; height: 24rpx; background: #c9a85e; border-radius: 4rpx; }
.ar-tip { font-size: var(--fs-small); color: #d8c7a4; text-align: center; margin: 18rpx 0 26rpx; line-height: 1.6; }
.ar-continue { width: 100%; }

/* 史料卡 · 卷轴碑帖 */
.source-panel {
  position: relative;
  width: 100%;
  background:
    radial-gradient(circle at 15% 10%, rgba(168,137,58,0.07), transparent 45%),
    linear-gradient(180deg, #fbf6ec 0%, #f4ecd8 100%);
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-deep);
  padding: 0 30rpx 28rpx;
  max-height: 80vh;
  overflow-y: auto;
}
.scroll-rod { display: flex; align-items: center; margin: 0 -16rpx 24rpx; }
.rod-knob {
  width: 28rpx; height: 28rpx; border-radius: 50%; flex: none;
  background: radial-gradient(circle at 35% 30%, #eedca6, #a8893a);
  box-shadow: 0 2rpx 6rpx rgba(90,60,20,0.4);
}
.rod-bar { flex: 1; height: 12rpx; background: linear-gradient(180deg, #c7a987, #8a6c3f); border-radius: 6rpx; }
.s-title {
  display: table;
  font-size: var(--fs-title); color: var(--ink); font-weight: 600;
  border-left: 8rpx solid var(--dark-gold);
  background: rgba(168,137,58,0.1);
  padding: 8rpx 20rpx;
  margin-bottom: 22rpx;
}
.s-work { background: rgba(255,255,255,0.45); border: 1rpx solid var(--line); border-radius: var(--radius); padding: 18rpx 20rpx; margin-bottom: 14rpx; }
.work-name { font-size: var(--fs-body); color: var(--dark-gold); font-weight: 600; }
.work-quote {
  font-size: var(--fs-small); color: var(--ink-soft); display: block; margin-top: 10rpx;
  line-height: 1.7; padding-left: 18rpx; border-left: 2rpx solid rgba(168,137,58,0.45);
}
.s-note { font-size: var(--fs-small); color: var(--ink-muted); line-height: 1.75; display: block; margin: 16rpx 0 18rpx; }
.s-seal {
  width: 64rpx; height: 64rpx; border-radius: 12rpx;
  background: linear-gradient(150deg, var(--cinnabar-soft), var(--cinnabar));
  display: flex; align-items: center; justify-content: center;
  transform: rotate(-6deg);
  box-shadow: 0 4rpx 12rpx rgba(158,74,42,0.3);
  margin: 0 0 18rpx auto;
}
.s-close { width: 100%; }

/* 结算 · 电影感鎏金 panel + dragon-scale got 态 */
.end-mask { animation: endFade 0.35s ease both; }
@keyframes endFade { from { opacity: 0; } to { opacity: 1; } }
.end-panel {
  position: relative;
  width: 100%;
  overflow: hidden;
  background:
    url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http://www.w3.org/2000/svg%22%20viewBox%3D%220%200%20200%20200%22%3E%3Cg%20opacity%3D%220.12%22%20fill%3D%22none%22%20stroke%3D%22%23a8893a%22%3E%3Ccircle%20cx%3D%22100%22%20cy%3D%22100%22%20r%3D%2284%22%20stroke-width%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%22100%22%20cy%3D%22100%22%20r%3D%2260%22%20stroke-width%3D%220.8%22%20stroke-dasharray%3D%222%207%22%2F%3E%3C%2Fg%3E%3Cg%20opacity%3D%220.12%22%20fill%3D%22%23a8893a%22%3E%3Ccircle%20cx%3D%22100%22%20cy%3D%2216%22%20r%3D%223.5%22%2F%3E%3Ccircle%20cx%3D%22184%22%20cy%3D%22100%22%20r%3D%223.5%22%2F%3E%3Ccircle%20cx%3D%22100%22%20cy%3D%22184%22%20r%3D%223.5%22%2F%3E%3Ccircle%20cx%3D%2216%22%20cy%3D%22100%22%20r%3D%223.5%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E') center 230rpx / 320rpx no-repeat,
    linear-gradient(180deg, var(--bg-card) 0%, #f6ecd8 100%);
  border-radius: 28rpx;
  border: 2rpx solid rgba(168,137,58,0.55);
  box-shadow: inset 0 0 0 6rpx rgba(251,246,236,0.55), 0 24rpx 60rpx rgba(50,38,22,0.35);
  padding: 30rpx 34rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: endRise 0.45s cubic-bezier(0.2, 1, 0.3, 1) both;
}
@keyframes endRise {
  from { opacity: 0; transform: translateY(40rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.end-crest { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.crest-line { height: 1rpx; width: 80rpx; background: linear-gradient(90deg, transparent, rgba(168,137,58,0.75)); }
.crest-line:last-child { background: linear-gradient(90deg, rgba(168,137,58,0.75), transparent); }
.crest-diamond { width: 12rpx; height: 12rpx; transform: rotate(45deg); background: var(--grad-gold); box-shadow: 0 0 8rpx rgba(168,137,58,0.6); }
.end-spot { font-size: var(--fs-mini); color: var(--ink-muted); letter-spacing: 3rpx; margin-bottom: 16rpx; }
.scale-stage {
  position: relative;
  width: 300rpx; height: 300rpx;
  display: flex; align-items: center; justify-content: center;
  margin: 4rpx 0 12rpx;
}
.scale-rays {
  position: absolute; width: 330rpx; height: 330rpx; border-radius: 50%;
  background: conic-gradient(from 0deg,
    rgba(216,189,126,0) 0deg, rgba(216,189,126,0.4) 10deg, rgba(216,189,126,0) 20deg,
    rgba(216,189,126,0.32) 60deg, rgba(216,189,126,0) 70deg,
    rgba(216,189,126,0.38) 120deg, rgba(216,189,126,0) 130deg,
    rgba(216,189,126,0.3) 180deg, rgba(216,189,126,0) 190deg,
    rgba(216,189,126,0.38) 240deg, rgba(216,189,126,0) 250deg,
    rgba(216,189,126,0.32) 300deg, rgba(216,189,126,0) 310deg);
  animation: raysSpin 14s linear infinite;
}
@keyframes raysSpin { to { transform: rotate(360deg); } }
.scale-halo {
  position: absolute; width: 210rpx; height: 210rpx; border-radius: 50%;
  border: 2rpx solid rgba(168,137,58,0.45);
  box-shadow: 0 0 40rpx rgba(216,189,126,0.5), inset 0 0 30rpx rgba(216,189,126,0.25);
  animation: haloPulse 2.6s ease-in-out infinite;
}
@keyframes haloPulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.08); opacity: 1; }
}
.scale-hero { position: relative; z-index: 2; transform: scale(1.9); }
.end-scale-name { font-size: var(--fs-h2); color: var(--dark-gold); font-weight: 600; letter-spacing: 4rpx; margin-bottom: 8rpx; }
.end-title { font-size: var(--fs-body); color: var(--ink-soft); letter-spacing: 3rpx; }
.end-progress { width: 100%; margin: 22rpx 0 26rpx; display: flex; flex-direction: column; align-items: center; }
.ep-track { width: 60%; height: 10rpx; border-radius: 999rpx; background: var(--bg-card-deep); border: 1rpx solid var(--line); overflow: hidden; }
.ep-fill { height: 100%; border-radius: 999rpx; background: var(--grad-gold); transition: width 0.6s ease; }
.end-sub { font-size: var(--fs-small); color: var(--ink-muted); margin-top: 12rpx; letter-spacing: 2rpx; }

/* 集齐奖励横幅：鎏金印章 + 象牙底，纯 tokens，不喧宾夺主 */
.reward-banner {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 0 8rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius);
  border: 1rpx solid var(--dark-gold-soft);
  background: var(--ivory);
  box-shadow: inset 0 0 0 1rpx rgba(194, 166, 104, 0.3);
}
.rb-seal {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--grad-gold);
  box-shadow: 0 2rpx 8rpx rgba(168, 137, 58, 0.4);
}
.rb-texts { display: flex; flex-direction: column; min-width: 0; }
.rb-title { font-size: var(--fs-body); color: var(--dark-gold); font-weight: 600; letter-spacing: 2rpx; }
.rb-desc { font-size: var(--fs-mini); color: var(--ink-soft); margin-top: 4rpx; }
.end-panel .btn-primary { width: 100%; }
.end-share {
  margin-top: 16rpx;
  background: var(--grad-gold);
  color: #fdf6e3;
  border: 2rpx solid rgba(255,246,224,0.5);
  box-shadow: 0 8rpx 20rpx rgba(168,137,58,0.35);
}
.end-back { margin-top: 16rpx; }

/* ===== 美术接线（数据驱动，见 docs/frontend-art-spec.md）===== */
/* 舞台背景 */
.stage.has-bg { background-size: cover; background-position: center; background-repeat: no-repeat; }
.stage-scrim {
  position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: linear-gradient(180deg, rgba(244,236,221,0.16) 0%, rgba(244,236,221,0.04) 42%, rgba(244,236,221,0.40) 100%);
}
.place-tag { z-index: 2; text-shadow: 0 1rpx 6rpx rgba(244,236,221,0.7); }

/* ===== 配音控制 ===== */
.voice-controls { display: flex; align-items: center; gap: 12rpx; }
.vc-btn, .source-mini {
  font-size: var(--fs-mini); color: var(--dark-gold);
  border: 1rpx solid var(--dark-gold-soft); border-radius: 999rpx;
  padding: 5rpx 18rpx; line-height: 1.7; background: rgba(255,255,255,0.55);
}
.source-mini { display: flex; align-items: center; gap: 6rpx; padding: 5rpx 14rpx; }
.source-mini-text { font-size: var(--fs-mini); }

/* ===== 集鳞仪式动画：dragon-scale got 态 ===== */
.scale-fx {
  position: fixed; inset: 0; z-index: 60;
  display: flex; align-items: center; justify-content: center;
  pointer-events: none;
  background: radial-gradient(circle at 50% 46%, rgba(198,160,86,0.22), rgba(40,32,20,0.6));
  animation: sfxFade 1.3s ease forwards;
}
@keyframes sfxFade {
  0% { opacity: 0; } 15% { opacity: 1; } 80% { opacity: 1; } 100% { opacity: 0; }
}
.scale-fx-glow {
  position: absolute; width: 360rpx; height: 360rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,224,150,0.85), rgba(214,170,90,0.25) 55%, transparent 72%);
  animation: sfxGlow 1.3s ease-out forwards;
}
@keyframes sfxGlow {
  0% { transform: scale(0.3); opacity: 0; }
  40% { opacity: 1; } 100% { transform: scale(1.5); opacity: 0.4; }
}
.scale-fx-rays {
  position: absolute; width: 520rpx; height: 520rpx; border-radius: 50%;
  background: conic-gradient(from 0deg,
    rgba(255,225,160,0) 0deg, rgba(255,225,160,0.55) 12deg, rgba(255,225,160,0) 24deg,
    rgba(255,225,160,0.45) 60deg, rgba(255,225,160,0) 72deg,
    rgba(255,225,160,0.5) 120deg, rgba(255,225,160,0) 132deg,
    rgba(255,225,160,0.4) 180deg, rgba(255,225,160,0) 192deg,
    rgba(255,225,160,0.5) 240deg, rgba(255,225,160,0) 252deg,
    rgba(255,225,160,0.45) 300deg, rgba(255,225,160,0) 312deg);
  animation: sfxSpin 1.3s ease-out forwards; opacity: 0.7;
}
@keyframes sfxSpin {
  0% { transform: rotate(0) scale(0.4); opacity: 0; }
  35% { opacity: 0.9; }
  100% { transform: rotate(120deg) scale(1.15); opacity: 0.2; }
}
.scale-fx-scale {
  position: relative; z-index: 2;
  width: 260rpx; height: 300rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  animation: sfxScale 1.3s cubic-bezier(0.2, 1.2, 0.4, 1) forwards;
}
@keyframes sfxScale {
  0% { transform: scale(0.2); opacity: 0; }
  45% { opacity: 1; }
  70% { transform: scale(1.08); }
  100% { transform: scale(1); opacity: 1; }
}
.sfx-halo {
  position: absolute; width: 250rpx; height: 250rpx; border-radius: 50%;
  border: 2rpx solid rgba(255,228,160,0.5);
  box-shadow: 0 0 60rpx rgba(255,214,120,0.6), inset 0 0 40rpx rgba(255,228,160,0.25);
  animation: sfxHalo 1.3s ease-out forwards;
}
@keyframes sfxHalo {
  0% { transform: scale(0.5); opacity: 0; }
  40% { opacity: 1; }
  100% { transform: scale(1.15); opacity: 0.35; }
}
.sfx-hero { transform: scale(1.75); }
.sfx-caption {
  margin-top: 24rpx;
  font-size: 26rpx; color: #f3e3b8; letter-spacing: 6rpx;
  text-shadow: 0 0 12rpx rgba(255,220,140,0.6);
  opacity: 0; animation: sfxCap 1.3s ease forwards;
}
@keyframes sfxCap { 0%, 40% { opacity: 0; } 62%, 100% { opacity: 1; } }
.scale-fx-particles { position: absolute; inset: 0; }
.sfx-pt {
  position: absolute; left: 50%; top: 46%;
  width: 14rpx; height: 14rpx; margin: -7rpx 0 0 -7rpx;
  border-radius: 50%; background: #ffe6a8;
  box-shadow: 0 0 12rpx rgba(255,220,140,0.9);
  animation: sfxPt 1.3s ease-out forwards;
}
@keyframes sfxPt {
  0% { opacity: 0; transform: rotate(calc(var(--i) * 36deg)) translateY(20rpx) scale(0.5); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: rotate(calc(var(--i) * 36deg)) translateY(-260rpx) scale(1); }
}

/* ===== 复原视频兜底：彻底消除模拟器黑屏 ===== */
@keyframes kenburns {
  0% { transform: scale(1.06) translate3d(-1.6%, -1.2%, 0); }
  100% { transform: scale(1.18) translate3d(1.6%, 1.1%, 0); }
}
@keyframes posterFade {
  from { opacity: 0; }
  to { opacity: 1; }
}
/* 舞台兜底画面（video 未播放时显示，带缓慢电影运镜） */
.stage-fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  animation: kenburns 18s ease-in-out infinite alternate, posterFade 0.7s ease both;
  transform-origin: 50% 50%;
  will-change: transform;
}
.stage-video {
  visibility: hidden; opacity: 0;
  background: transparent;
  transition: opacity 0.6s ease;
}
.stage-video.is-playing { visibility: visible; opacity: 1; }

/* AR 复原容器与兜底画面 */
.ar-media {
  position: relative;
  width: 100%;
  height: 500rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius);
  overflow: hidden;
  border: 2rpx solid rgba(216,189,126,0.5);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.35);
}
.ar-fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  animation: kenburns 16s ease-in-out infinite alternate, posterFade 0.7s ease both;
  will-change: transform;
}
.ar-restore {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.6s ease;
}
.ar-restore.is-playing { visibility: visible; opacity: 1; }
