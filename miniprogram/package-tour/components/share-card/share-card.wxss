.sc-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(58, 50, 40, 0.62);
  display: flex; align-items: center; justify-content: center;
  padding: 40rpx;
}
.sc-panel {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 36rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  display: flex; flex-direction: column; align-items: center;
  max-height: 92vh; overflow-y: auto;
}
.sc-title { font-size: var(--fs-h2); color: var(--ink); font-weight: 600; }
.sc-sub { font-size: var(--fs-small); color: var(--ink-muted); margin: 8rpx 0 24rpx; letter-spacing: 2rpx; }

.sc-canvas-wrap { position: relative; width: 100%; display: flex; justify-content: center; }
.sc-canvas { width: 560rpx; height: 840rpx; border-radius: 20rpx; box-shadow: var(--shadow-deep); }
.sc-loading {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  font-size: var(--fs-small); color: var(--ink-muted);
}

.sc-save { width: 100%; margin-top: 26rpx; }
.sc-share { width: 100%; margin-top: 16rpx; }
.sc-close {
  margin-top: 18rpx; font-size: var(--fs-small); color: var(--ink-muted);
  background: transparent; border: none;
}
.sc-close::after { border: none; }
